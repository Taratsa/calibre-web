pustaka.taratsa.id {
  request_body {
    max_size 500MB
  }

  encode zstd gzip

  route {
    # ─── Flask: stateful + admin + reader + cached asset endpoints ───
    @flask {
      path /admin* /ajax/* /admin/*
      path /login /login/* /logout /logout/*
      path /me /register* /remote_login*
      path /read/* /show/* /download/* /send/*
      path /opds /opds/* /kobo/*
      path /cover/* /cover_thumb/* /series_cover/*
      path /book/*?
      path /.well-known/*
      path /table /downloadlist
      path /metrics
      path /feed.xml /osd.xml /index.xml
    }
    handle @flask {
      # Long-cache download files
      @books {
        path /download/*/pdf/* /download/*/epub/*
      }
      header @books >Cache-Control "public, max-age=3888000"

      # WebP-friendly cover assets
      @covers {
        path /cover/* /cover_thumb/*
      }
      header @covers >Cache-Control "public, max-age=86400"
      header @covers >Vary "Accept, Accept-Encoding"

      reverse_proxy calibre-web-automated:8083
    }

    # ─── Static frontend: Astro-built HTML + assets ───
    root * /srv/frontend

    @astro_assets {
      path /_astro/* /favicon.ico /logo-taratsa.png /static/*
    }
    handle @astro_assets {
      header >Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    # Default: serve the static file
    handle {
      header >Cache-Control "public, max-age=300, must-revalidate"
      rewrite * /index.html
      try_files {path} {path}.html {path}/index.html /404.html
      file_server
    }
  }

  log
}

# Old Flask-rendered frontend (pre-Astro UI)
