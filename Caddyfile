pustaka.taratsa.id {
  request_body {
    max_size 500MB
  }

  encode zstd gzip

  route {
    # ─── Astro dynamic Open Graph images ───
    @astro_og {
      path /og/*.png /og/*/*.png
    }
    handle @astro_og {
      header >Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
      header >Cloudflare-CDN-Cache-Control "public, max-age=86400"
      reverse_proxy pustaka-astro:4321
    }

    # ─── Astro OCR reader page ───
    @astro_ocr {
      path_regexp astro_ocr ^/read/[0-9]+/ocr(/(pdf|epub))?/?$
    }
    handle @astro_ocr {
      header >Cache-Control "private, no-store"
      header >Cloudflare-CDN-Cache-Control "no-store"
      reverse_proxy pustaka-astro:4321
    }

    # ─── Flask: stateful + admin + reader + cached asset endpoints ───

    @flask {
      path /admin* /ajax/* /admin/*
      path /login /login/* /logout /logout/*
      path /me /register* /remote_login*
      path /health /healthz /healthz/* /readyz
      path /read/* /show/* /download/* /send/* /api/read/*
      path /opds /opds/* /kobo/*
      path /cover/* /cover_thumb/* /series_cover/*
      # path /book/*/* /book/*/*/ /book/*/*/*  # Astro serves static book pages
      path /.well-known/*
      path /table /downloadlist
      path /metrics
      path /feed.xml /osd.xml /index.xml
    }
    handle @flask {
      @books {
        path /download/* /opds/download/* /kobo/*/download/*
      }
      header @books >Cache-Control "private, no-store"
      header @books >Cloudflare-CDN-Cache-Control "no-store"
      # Cache OPDS catalog feeds (5 min — catalog changes are batch-rebuilt),
      # but never the per-book acquisition downloads under /opds/download/
      @opds {
        path /opds /opds/new* /opds/books* /opds/author* /opds/publisher* /opds/category* /opds/series* /opds/hot* /opds/rated* /opds/search* /opds/osd* /opds/stats*
      }
      header @opds >Cache-Control "public, max-age=300"

      # WebP cover assets — backend serves fixed WebP regardless of Accept,
      # so Vary: Accept is omitted to enable Cloudflare edge caching
      @covers {
        path /cover/* /cover_thumb/*
      }
      header @covers >Cache-Control "public, max-age=86400"

      reverse_proxy calibre-web-automated:8083
    }

    @legacy_author {
      path_regexp legacy_author ^/author/[0-9]+(/page/[0-9]+|/[0-9]+)?/?$
    }
    handle @legacy_author {
      reverse_proxy calibre-web-automated:8083
    }

    @legacy_book {
      path_regexp legacy_book ^/book/[0-9]+/?$
    }
    handle @legacy_book {
      reverse_proxy calibre-web-automated:8083
    }

    # Astro renders canonical frontend pages on demand.
    @astro_assets {
      path /_astro/* /favicon.ico /logo-taratsa.png /static/*
    }
    handle @astro_assets {
      header >Cache-Control "public, max-age=31536000, immutable"
      header >Strict-Transport-Security "max-age=31536000; includeSubDomains"
      header >X-Content-Type-Options "nosniff"
      header >X-Frame-Options "SAMEORIGIN"
      file_server
    }

    handle {
      reverse_proxy pustaka-astro:4321
    }

    # Default: serve the static file
    handle {
      header >Cache-Control "public, max-age=300, must-revalidate"
      header >Strict-Transport-Security "max-age=31536000; includeSubDomains"
      header >X-Content-Type-Options "nosniff"
      header >X-Frame-Options "SAMEORIGIN"
      header >Referrer-Policy "strict-origin-when-cross-origin"
      try_files {path} {path}.html {path}/index.html /404.html
      file_server
    }
  }

  log
}

# Old Flask-rendered frontend (pre-Astro UI)
old.pustaka.taratsa.id {
  request_body {
    max_size 500MB
  }

  encode zstd gzip

  @books {
    path /download/* /opds/download/* /kobo/*/download/*
  }
  header @books >Cache-Control "private, no-store"
  header @books >Cloudflare-CDN-Cache-Control "no-store"
  reverse_proxy calibre-web-automated:8083

  log
}
