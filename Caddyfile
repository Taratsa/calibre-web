# Caddyfile for pustaka.taratsa.id
#
# Two services behind one host:
#   - Flask (calibre-web-automated:8083) — admin, login, reader, downloads,
#     OPDS, Kobo sync, AI catalog, .well-known, covers, api endpoints.
#   - Static frontend (/srv/frontend) — public catalog pages pre-built from
#     Calibre metadata.db by frontend/scripts/seed.mjs.
#
# The @flask matcher covers everything Flask must keep serving. Everything
# else falls through to the file_server block.
#
# Rollback: replace the route block with `reverse_proxy calibre-web-automated:8083`.

pustaka.taratsa.id {
  request_body { max_size 500MB }

  encode zstd gzip

  route {
    # ─── Flask: stateful + admin + reader + cached asset endpoints ───
    @flask {
      path /admin* /ajax/* /admin/*
          /login /login/* /logout /logout/*
          /me /register* /remote_login*
          /read/* /show/* /download/* /send/*
          /opds/* /kobo/*
          /cover/* /series_cover/*
          /.well-known/*
          /table /downloadlist
          /metrics
          /feed.xml /osd.xml /index.xml
    }
    handle @flask {
      # Long-cache download files
      @books {
        path /download/*/pdf/* /download/*/epub/*
      }
      header @books >Cache-Control "public, max-age=3888000"

      # WebP-friendly cover assets
      @covers {
        path /cover/*
      }
      header @covers >Cache-Control "public, max-age=86400"
      header @covers >Vary "Accept, Accept-Encoding"

      reverse_proxy calibre-web-automated:8083
    }

    # ─── Static frontend: Astro-built HTML + assets ───
    # /book/<id>/<slug>/ legacy redirects go through Flask's @flask block
    # above as well, since /book/* isn't matched there. We send /book/* to
    # Astro (the static file) and let Flask continue to own slug-form via
    # a separate static redirect file baked at build time.
    root * /srv/frontend

    @astro_assets {
      path /_astro/* /favicon.ico /logo-taratsa.png /static/*
    }
    handle @astro_assets {
      header >Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    # Default: serve the static file. Falls back to /404.html for missing paths.
    handle {
      header >Cache-Control "public, max-age=300, must-revalidate"
      rewrite * /index.html
      try_files {path} {path}.html {path}/index.html /404.html
      file_server
    }
  }

  log
}
