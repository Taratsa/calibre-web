#!/usr/bin/with-contenv bash
# shellcheck shell=bash

export CALIBRE_DBPATH=/config

# fix ownership + recover WAL from previous crashed sessions
chown -R abc:abc /config 2>/dev/null || true
chown abc:abc /calibre-library /calibre-library/metadata.db 2>/dev/null || true
python3 -c "
import sqlite3, os
db = '/config/app.db'
if os.path.exists(db):
    try:
        conn = sqlite3.connect(db)
        conn.execute('PRAGMA wal_checkpoint(TRUNCATE)')
        conn.close()
    except Exception:
        pass
" 2>/dev/null || true

exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z localhost 8083" \
        cd /app/calibre-web s6-setuidgid abc python3 /app/calibre-web/cps.py
