# Minimal Caddyfile for Pustaka
# Place this next to docker-compose.yml or adjust the volume mount path

:80 {
    # Redirect to HTTPS in production
    # handle / {
    #     respond "HTTPS only"
    # }

    # Uncomment for HTTPS + HTTP redirect
    # acme_ca https://acme.zerossl.com/v2/DV90
    # email your@email.com

    encode zstd gzip

    request_body {
        max_size 500MB
    }

    @astro_ocr {
        path_regexp astro_ocr ^/read/[0-9]+/ocr(/(pdf|epub))?/?$
    }
    handle @astro_ocr {
        header >Cache-Control "private, no-store"
        reverse_proxy pustaka-astro:4321
    }

    @astro_metadata {
        path /robots.txt /sitemap.xml /sitemap-index.xml /sitemaps/*
    }
    handle @astro_metadata {
        reverse_proxy pustaka-astro:4321
    }

    @flask {
        path /admin* /ajax/* /admin/*
        path /login /login/* /logout /logout/*
        path /me /register* /remote_login*
        path /read/* /show/* /download/* /send/*
        path /opds /opds/* /kobo/*
        path /cover/* /series_cover/*
        path /book/*?
        path /.well-known/*
        path /table /downloadlist
        path /metrics
        path /feed.xml /osd.xml /index.xml
    }
    handle @flask {
        @books {
            path /download/*/pdf/* /download/*/epub/*
        }
        header @books >Cache-Control "private, no-store"
        header @books >Cloudflare-CDN-Cache-Control "no-store"
        @covers {
            path /cover/*
        }
        header @covers >Cache-Control "public, max-age=86400"
        header @covers >Vary "Accept, Accept-Encoding"

        reverse_proxy calibre-web-automated:8083
    }

    @legacy_author {
        path_regexp legacy_author ^/author/[0-9]+(/page/[0-9]+|/[0-9]+)?/?$
    }
    handle @legacy_author {
        reverse_proxy calibre-web-automated:8083
    }

    @legacy_book {
        path_regexp legacy_book ^/book/[0-9]+/?$
    }
    handle @legacy_book {
        reverse_proxy calibre-web-automated:8083
    }

    root * /srv/frontend

    @assets {
        path /_astro/* /favicon.ico /logo-taratsa.png /static/*
    }
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        header Cache-Control "public, max-age=300, must-revalidate"
        try_files {path} {path}.html {path}/index.html /404.html
        file_server
    }

    log {
        output file /var/log/caddy/pustaka.log
    }
}
