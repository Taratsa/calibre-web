---
import type { BookSummary } from '~/data/types';
import Cover from './Cover.astro';
import { truncateAuthorsHtml } from '~/utils/authors';

export interface Props {
  book: BookSummary;
  size?: 'sm' | 'md' | 'lg';
  priority?: boolean;
}

const { book, size = 'md', priority = false } = Astro.props;
const widths = { sm: 120, md: 200, lg: 320 };
const w = widths[size];
const authorHtml = truncateAuthorsHtml(book.authors ?? [], 60);
const showAuthors = (book.authors ?? []).length > 0;
const coverImg = book.cover_url.replace(/\?.*$/, '');
const coverH = Math.round(w * 1.5);
---

<article class={`book-card book-card--${size}`}>
  <a href={book.url} class="book-card__cover" aria-label={`Cover ${book.title}`}>
    <Cover image={coverImg} alt={book.title} width={w} height={coverH} loading={priority ? "eager" : "lazy"} fetchpriority={priority ? "high" : "auto"} />
  </a>
  <h3 class="book-card__title">
    <a href={book.url} set:html={book.title} />
  </h3>
  {showAuthors && (
    <p class="book-card__authors" set:html={authorHtml} />
  )}
</article>

<style>
  .book-card { margin: 0; }
  .book-card__cover { display: block; }
  .book-card__cover img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.1);
  }
  .book-card__title {
    font-size: 1rem;
    margin: 0.5rem 0 0.25rem;
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
  }
  .book-card__title a {
    color: #1f1f1f;
    text-decoration: none;
  }
  .book-card__title a:hover { text-decoration: underline; }
  .book-card__authors {
    margin: 0;
    font-size: 0.85rem;
    color: #6b7280;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
  }
  .book-card__authors a { color: #6b7280; }
  .book-card__authors .more { color: #9ca3af; font-style: italic; }
</style>