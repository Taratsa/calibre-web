---
import type { BookSummary } from '~/data/types';
import Cover from './Cover.astro';
import { truncateAuthorsHtml } from '~/utils/authors';
import { bookPath } from '~/utils/book-url';
export interface Props {
  book: BookSummary;
  size?: 'sm' | 'md' | 'lg';
  priority?: boolean;
  /** Heading level of the card title; one below the heading that introduces the grid. */
  level?: 2 | 3 | 4;
}

const { book, size = 'md', priority = false, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
const widths = { sm: 120, md: 200, lg: 320 };
const w = widths[size];
const authorHtml = truncateAuthorsHtml(book.authors ?? [], 60);
const showAuthors = (book.authors ?? []).length > 0;
const coverImg = book.cover_url.replace(/\?.*$/, '');
const coverH = Math.round(w * 1.5);
const href = `${bookPath(book)}/`;
---

<article class={`book-card book-card--${size}`}>
    <a href={href} class="book-card__cover" tabindex="-1" aria-hidden="true">
    <Cover image={coverImg} alt="" width={w} height={coverH} loading={priority ? "eager" : "lazy"} fetchpriority={priority ? "high" : "auto"} />
  </a>
  <Heading class="book-card__title">
    <a href={href} set:html={book.title.trim()} />
  </Heading>
  {showAuthors && (
    <p class="book-card__authors" set:html={authorHtml} />
  )}
</article>

<style>
  .book-card { margin: 0; }
  .book-card__cover { display: block; min-height: 0; min-width: 0; }
  :global(.book-card__cover img) {
    width: 100% !important;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 4px;
    background: var(--surface-3);
    box-shadow: 0 1px 3px var(--shadow-sm);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .book-card__cover:hover :global(img) { box-shadow: 0 4px 14px var(--shadow-lg); transform: translateY(-2px); }
  .book-card__title {
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0.5rem 0 0.1rem;
    line-height: 1.3;
  }
  /* The clamp sits on the link, so its box is exactly the visible lines; at least 24px tall (WCAG 2.5.8). */
  .book-card__title a {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
    min-height: 24px;
    min-width: 0;
    color: var(--fg);
    text-decoration: none;
  }
  .book-card__title a:hover { text-decoration: underline; }
  .book-card__authors {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    word-break: break-word;
  }
  /* Links inside set:html carry no scope attribute, so these need :global(). 24px tall hit area (WCAG 2.5.8). */
  .book-card__authors :global(a) {
    display: inline-block;
    min-height: 0;
    min-width: 0;
    line-height: 1.5rem;
    color: var(--muted);
    text-decoration: none;
  }
  .book-card__authors :global(a:hover) { text-decoration: underline; }
  .book-card__authors :global(.more) { color: var(--muted); font-style: italic; }
  @media (prefers-reduced-motion: reduce) {
    :global(.book-card__cover img) { transition: none; }
    .book-card__cover:hover :global(img) { transform: none; }
  }
</style>