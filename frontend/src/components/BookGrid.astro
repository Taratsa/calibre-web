---
import type { BookSummary } from '~/data/types';
import BookCard from './BookCard.astro';

export interface Props {
  books: BookSummary[];
  /** Heading level of each card title: one below the heading that introduces the grid (h1 pages: 2, the default). */
  level?: 2 | 3 | 4;
}

const { books, level = 2 } = Astro.props;
---

{books.length > 0 ? (
  <ul class="book-grid">
    {books.map((book, index) => (
      <li>
        <BookCard book={book} priority={index < 6} level={level} />
      </li>
    ))}
  </ul>
) : (
  <p class="empty">Tidak ada buku dalam koleksi ini.</p>
)}

<style>
  /* Dense cover wall: as many ~9.5rem columns as the content width allows, so a wide screen shows 8+ per row and a
     phone shows 2, with no per-page column counts. */
  .book-grid {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 1.5rem 1rem;
  }
  .book-grid > li { min-width: 0; }
  @media (max-width: 479px) {
    .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 0.75rem; }
  }
  .empty { color: var(--muted); }
</style>
