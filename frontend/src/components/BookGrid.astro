---
import type { BookSummary } from '~/data/types';
import BookCard from './BookCard.astro';

export interface Props {
  books: BookSummary[];
  cols?: 2 | 3 | 4 | 5 | 6;
}

const { books, cols = 5 } = Astro.props;
---

{books.length > 0 ? (
  <ul class={`book-grid book-grid--cols-${cols}`}>
    {books.map((book, index) => (
      <li>
        <BookCard book={book} priority={index < 4} />
      </li>
    ))}
  </ul>
) : (
  <p class="empty">Tidak ada buku dalam koleksi ini.</p>
)}

<style>
  .book-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    gap: 1.5rem;
  }
  .book-grid--cols-2 { grid-template-columns: repeat(2, 1fr); }
  .book-grid--cols-3 { grid-template-columns: repeat(3, 1fr); }
  .book-grid--cols-4 { grid-template-columns: repeat(4, 1fr); }
  .book-grid--cols-5 { grid-template-columns: repeat(5, 1fr); }
  .book-grid--cols-6 { grid-template-columns: repeat(6, 1fr); }
  @media (max-width: 767px) {
    .book-grid--cols-2,
    .book-grid--cols-3,
    .book-grid--cols-4,
    .book-grid--cols-5,
    .book-grid--cols-6 { grid-template-columns: repeat(2, 1fr); }
  }
  .empty { color: var(--muted); }
</style>
