---
export interface Props {
  page: number;
  totalPages: number;
  baseUrl: string;
}

const { page, totalPages, baseUrl } = Astro.props;
const rootUrl = baseUrl.replace(/\/+$/, '');
const pageRootUrl = rootUrl.endsWith('/page') ? rootUrl.slice(0, -5) : rootUrl;

function pageHref(p: number) {
  if (p === 1) return `${pageRootUrl}/`;
  return `${pageRootUrl}/page/${p}/`;
}

const pages: (number | '…')[] = [];
const window = 1;
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= page - window && i <= page + window)) {
    pages.push(i);
  } else if (pages[pages.length - 1] !== '…') {
    pages.push('…');
  }
}

const hasPrev = page > 1;
const hasNext = page < totalPages;
const prevHref = pageHref(page - 1);
const nextHref = pageHref(page + 1);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Halaman">
    <ol>
      <li class="pagination__item pagination__item--nav">
        {hasPrev ? (
          <a class="pagination__link" href={prevHref} rel="prev" aria-label="Halaman sebelumnya">
            <svg class="pagination__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span class="pagination__label">Sebelumnya</span>
          </a>
        ) : (
          <span class="pagination__link pagination__link--disabled" aria-disabled="true" aria-label="Halaman sebelumnya">
            <svg class="pagination__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span class="pagination__label">Sebelumnya</span>
          </span>
        )}
      </li>
      {pages.map((p) =>
        p === '…' ? (
          <li class="pagination__item pagination__item--ellipsis" aria-hidden="true">
            <span>…</span>
          </li>
        ) : p === page ? (
          <li class="pagination__item pagination__item--current">
            <span aria-current="page" aria-label={`Halaman ${p}, saat ini`}>{p}</span>
          </li>
        ) : (
          <li class="pagination__item">
            <a class="pagination__link" href={pageHref(p as number)} aria-label={`Halaman ${p}`}>{p}</a>
          </li>
        )
      )}
      <li class="pagination__item pagination__item--nav">
        {hasNext ? (
          <a class="pagination__link" href={nextHref} rel="next" aria-label="Halaman selanjutnya">
            <span class="pagination__label">Selanjutnya</span>
            <svg class="pagination__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        ) : (
          <span class="pagination__link pagination__link--disabled" aria-disabled="true" aria-label="Halaman selanjutnya">
            <span class="pagination__label">Selanjutnya</span>
            <svg class="pagination__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        )}
      </li>
    </ol>
  </nav>
)}

<style>
  .pagination {
    display: flex;
    justify-content: center;
    margin: 2.5rem 0 1rem;
  }
  .pagination ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pagination__item {
    display: inline-flex;
  }
  .pagination__link,
  .pagination__item--current span,
  .pagination__item--ellipsis span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--fg);
    font-size: 0.9rem;
    line-height: 1;
    text-decoration: none;
    text-align: center;
    justify-content: center;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .pagination__item--nav .pagination__link {
    padding: 0 0.9rem;
  }
  .pagination__link:hover {
    background: var(--surface-3);
    border-color: var(--muted-soft);
  }
  .pagination__link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .pagination__item--current span {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--inverse-fg);
    font-weight: 600;
  }
  .pagination__item--ellipsis span {
    border-color: transparent;
    background: transparent;
    color: var(--muted);
  }
  .pagination__link--disabled {
    color: var(--muted-soft);
    border-color: var(--border-subtle);
    background: var(--surface-2);
    cursor: not-allowed;
    pointer-events: none;
  }
  .pagination__icon {
    flex: 0 0 auto;
  }
  @media (max-width: 480px) {
    .pagination__label {
      display: none;
    }
    .pagination__item--nav .pagination__link {
      padding: 0;
      width: 2.5rem;
    }
  }
</style>
