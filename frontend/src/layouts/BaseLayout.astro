---
import { getAllAuthors, getAllBooks, getAllCategories, getAllLanguages, getAllPublishers, getAllSeries, getShelves } from '~/data';
import { clippings } from '~/data/clippings';
import { videos } from '~/data/videos';
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'book' | 'profile' | 'article';
  /** og:locale; defaults to the site language. */
  locale?: string;
}

const { title, description, ogImage, canonical, noindex = false, ogType, locale = 'id_ID' } = Astro.props;
const siteUrl = 'https://pustaka.taratsa.id';
function cleanPath(pathname: string): string {
  if (pathname === '/' || pathname === '/index.html') return '/';
  if (pathname.endsWith('/index.html')) return pathname.slice(0, -10) + '/';
  if (pathname.endsWith('.html')) return pathname.slice(0, -5);
  return pathname;
}
function absoluteUrl(path: string): string {
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  return new URL(path, siteUrl).toString();
}
const canonicalUrl = absoluteUrl(canonical ?? cleanPath(Astro.url.pathname));
const defaultDescription = 'Pustaka Taratsa adalah perpustakaan digital non-komersil berakses terbuka yang mengoleksi dan mengarsip buku langka, zine, serta literatur terkait Indonesia';
const fullTitle = `${title} | Pustaka Taratsa`;
const ogTitle = title;
const ogDescription = description ?? defaultDescription;
const ogImageUrl = ogImage ?? `${siteUrl}/og/home.png`;

// Sidebar navigation. Counts come from the same build-time data the pages use.
const currentPath = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
const formatCount = new Intl.NumberFormat('id-ID');
interface NavLink { href: string; label: string; count?: number }
const primaryNav: NavLink[] = [
  { href: '/', label: 'Beranda' },
  { href: '/page/', label: 'Semua buku', count: getAllBooks().length },
  { href: '/populer/', label: 'Populer' },
];
const collectionNav: NavLink[] = [
  { href: '/author/', label: 'Penulis', count: getAllAuthors().length },
  { href: '/series/', label: 'Seri', count: getAllSeries().length },
  { href: '/publisher/', label: 'Penerbit', count: getAllPublishers().length },
  { href: '/category/', label: 'Kategori', count: getAllCategories().length },
  { href: '/language/', label: 'Bahasa', count: getAllLanguages().length },
];
const shelfNav: NavLink[] = getShelves().map((shelf) => ({
  href: `/shelf/${shelf.id}/`,
  label: shelf.name.trim(),
  count: shelf.book_ids.length,
}));
const moreNav: NavLink[] = [
  { href: '/kliping/', label: 'Kliping', count: clippings.length },
  { href: '/video/', label: 'Video', count: videos.length },
  { href: '/data/', label: 'Data' },
  { href: '/about/', label: 'Tentang Kami' },
];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta name="description" content={ogDescription} />
    <meta property="og:site_name" content="Pustaka Taratsa" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType ?? (title === 'Beranda' ? 'website' : 'book')} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://umami.kenadera.org" />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://umami.kenadera.org" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="preconnect" href="https://feedback.taratsa.id" />
    <link rel="dns-prefetch" href="https://feedback.taratsa.id" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="geolocation=(), camera=(), microphone=()" />

    <link rel="alternate" type="application/opensearchdescription+xml" href="/opensearch.xml" title="Pustaka Taratsa" />
    <link rel="sitemap" href="/sitemap.xml" type="application/xml" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <link rel="service-desc" href="/opds" />
    <link rel="service-doc" href="/.well-known/agent-skills/index.json" />
    <link rel="describedby" href="/.well-known/mcp/server-card.json" />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      // Applied before first paint so a stored preference never flashes.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {}
    </script>

    <slot name="head" />

    <script type="application/ld+json">{
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://pustaka.taratsa.id#organization",
      "name": "Pustaka Taratsa",
      "url": "https://pustaka.taratsa.id",
      "logo": "https://pustaka.taratsa.id/logo-taratsa.png",
      "description": "Perpustakaan digital non-komersil yang mengoleksi dan mengarsip buku langka, zine, serta literatur terkait Indonesia.",
      "sameAs": [
        "https://x.com/taratsa_id",
        "https://www.instagram.com/taratsa.id/"
      ]
    }</script>

    <script type="application/ld+json">{
      "@context": "https://schema.org",
      "@type": "WebSite",
      "url": "https://pustaka.taratsa.id",
      "name": "Pustaka Taratsa",
      "description": "Perpustakaan digital non-komersil yang mengoleksi dan mengarsip buku langka, zine, serta literatur terkait Indonesia.",
      "inLanguage": "id",
      "publisher": { "@id": "https://pustaka.taratsa.id#organization" }
    }</script>

    <script defer src="https://umami.kenadera.org/script.js" data-website-id="0b57aeb6-d996-4d88-89fc-59ada511cd9c" data-performance="true" data-do-not-track="true" data-errors="true" type="text/javascript"></script>
    <!-- START Formbricks Surveys -->
    <script is:inline type="text/javascript">
      !function () {
        var appUrl = "https://feedback.taratsa.id";
        var workspaceId = "cmuxi018b000101pfmpnjlaav";
        var t = document.createElement("script");
        t.type = "text/javascript";
        t.async = true;
        t.src = appUrl + "/js/formbricks.umd.cjs";
        t.onload = function () {
          try {
            // A failed sync leaves {status:{value:"error",expiresAt:+10min}} in localStorage with NO config. Until it
            // expires the SDK skips initialization, and its page-view check then throws "config is null, maybe the init
            // function was not called?" on every page load. Drop that backoff so a transient failure (edge 5xx, a
            // blocked request) costs one visit instead of leaving the widget dead for ten minutes.
            var stored = null;
            try {
              stored = JSON.parse(localStorage.getItem("formbricks-js"));
            } catch (ignore) {}
            if (stored && stored.status && stored.status.value === "error") {
              localStorage.removeItem("formbricks-js");
            }
            window.formbricks.setup({ workspaceId: workspaceId, appUrl: appUrl });
          } catch (ignore) {
            // The widget is optional: never let it break the page.
          }
        };
        var e = document.getElementsByTagName("script")[0];
        e.parentNode.insertBefore(t, e);
      }();
    </script>
    <!-- END Formbricks Surveys -->
  </head>
  <body>
    <input type="checkbox" id="nav-open" class="nav-check" aria-label="Buka menu navigasi" />
    <div class="app">
      <header class="topbar">
        <a href="/" class="brand" aria-label="Beranda Pustaka Taratsa">
          <img class="logo-light" src="/logo-taratsa.webp" alt="" width="28" height="28" fetchpriority="high" loading="eager" style="height:28px;width:auto;" />
          <img class="logo-dark" src="/logo-taratsa-white.webp" alt="" width="28" height="28" loading="eager" style="height:28px;width:auto;" />
          <span>Pustaka Taratsa</span>
        </a>
        <label for="nav-open" class="menu-btn" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </label>
      </header>

      <aside class="sidebar" id="sidebar" aria-label="Navigasi">
        <a href="/" class="brand" aria-label="Beranda Pustaka Taratsa">
          <img class="logo-light" src="/logo-taratsa.webp" alt="" width="28" height="28" loading="eager" style="height:28px;width:auto;" />
          <img class="logo-dark" src="/logo-taratsa-white.webp" alt="" width="28" height="28" loading="eager" style="height:28px;width:auto;" />
          <span>Pustaka Taratsa</span>
        </a>
        <form action="/search/" method="GET" role="search" aria-label="Formulir pencarian" class="side-search">
          <input type="search" name="q" placeholder="Cari buku, penulis, isi buku…" aria-label="Kata kunci pencarian" autocomplete="off" />
          <div class="side-search__modes">
            <button type="submit" class="side-search__mode side-search__mode--main">Katalog</button>
            <button type="submit" class="side-search__mode" formaction="/search/text/" title="Cari kata di dalam isi buku">Di dalam teks</button>
          </div>
          <a class="side-search__advanced" href="/search/?advanced=1">Pencarian lanjutan</a>
        </form>
        <nav class="side-section" aria-label="Navigasi utama">
          {primaryNav.map((link) => (
            <a class="side-link" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              <span>{link.label}</span>
              {link.count !== undefined && <span class="side-link__count">{formatCount.format(link.count)}</span>}
            </a>
          ))}
        </nav>
        <nav class="side-section" aria-labelledby="side-koleksi">
          <p class="side-label" id="side-koleksi">Koleksi</p>
          {collectionNav.map((link) => (
            <a class="side-link" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              <span>{link.label}</span>
              {link.count !== undefined && <span class="side-link__count">{formatCount.format(link.count)}</span>}
            </a>
          ))}
        </nav>
        {shelfNav.length > 0 && (
          <nav class="side-section" aria-labelledby="side-rak">
            <p class="side-label" id="side-rak"><a href="/shelf/">Rak</a></p>
            {shelfNav.map((link) => (
              <a class="side-link" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                <span class="side-link__text">{link.label}</span>
                <span class="side-link__count">{formatCount.format(link.count ?? 0)}</span>
              </a>
            ))}
          </nav>
        )}
        <nav class="side-section" aria-labelledby="side-lainnya">
          <p class="side-label" id="side-lainnya">Lainnya</p>
          {moreNav.map((link) => (
            <a class="side-link" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              <span>{link.label}</span>
              {link.count !== undefined && <span class="side-link__count">{formatCount.format(link.count)}</span>}
            </a>
          ))}
        </nav>
        <div class="side-foot">
          <a href="/admin" class="side-foot__admin">Masuk admin</a>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Ganti mode terang/gelap" title="Ganti mode terang/gelap">
            <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/></svg>
          </button>
        </div>
      </aside>
      <label for="nav-open" class="scrim" aria-hidden="true"></label>

      <div class="content">
        <main class="container">
          <slot />
        </main>

        <footer class="site-footer">
          <p>Pustaka Taratsa — perpustakaan digital non-komersil.</p>
          <p><a href="/opensearch.xml">OpenSearch</a></p>
        </footer>
      </div>
    </div>

    <script>
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        const root = document.documentElement;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        const current = () => root.dataset.theme || (systemDark.matches ? 'dark' : 'light');
        const sync = () => {
          themeBtn.setAttribute('aria-pressed', String(current() === 'dark'));
        };
        themeBtn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
        systemDark.addEventListener('change', sync);
        sync();
      }
      // Close the mobile drawer after following a link or pressing Escape.
      const navOpen = document.getElementById('nav-open') as HTMLInputElement | null;
      if (navOpen) {
        document.getElementById('sidebar')?.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('a')) navOpen.checked = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') navOpen.checked = false;
        });
      }
    </script>
    <script>
      import '../scripts/webmcp';
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
