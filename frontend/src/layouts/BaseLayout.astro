---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'book' | 'profile' | 'article';
}

const { title, description, ogImage, canonical, noindex = false, ogType } = Astro.props;
const siteUrl = 'https://pustaka.taratsa.id';
function cleanPath(pathname: string): string {
  if (pathname === '/' || pathname === '/index.html') return '/';
  if (pathname.endsWith('/index.html')) return pathname.slice(0, -10) + '/';
  if (pathname.endsWith('.html')) return pathname.slice(0, -5);
  return pathname;
}
function absoluteUrl(path: string): string {
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  return new URL(path, siteUrl).toString();
}
const canonicalUrl = absoluteUrl(canonical ?? cleanPath(Astro.url.pathname));
const defaultDescription = 'Pustaka Taratsa adalah perpustakaan digital non-komersil berakses terbuka yang mengoleksi dan mengarsip buku langka, zine, serta literatur terkait Indonesia';
const fullTitle = `${title} | Pustaka Taratsa`;
const ogTitle = title;
const ogDescription = description ?? defaultDescription;
const ogImageUrl = ogImage ?? `${siteUrl}/static/images/Header_Beranda.webp`;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta name="description" content={ogDescription} />
    <meta property="og:site_name" content="Pustaka Taratsa" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType ?? (title === 'Beranda' ? 'website' : 'book')} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://umami.kenadera.org" />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://umami.kenadera.org" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="geolocation=(), camera=(), microphone=()" />

    <link rel="alternate" type="application/opensearchdescription+xml" href="/opensearch.xml" title="Pustaka Taratsa" />
    <link rel="sitemap" href="/sitemap.xml" type="application/xml" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <link rel="service-desc" href="/opds" />
    <link rel="search" href="/osd.xml" type="application/opensearchdescription+xml" />
    <link rel="service-doc" href="/.well-known/agent-skills/index.json" />
    <link rel="describedby" href="/.well-known/mcp/server-card.json" />

    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16161a" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      // Applied before first paint so a stored preference never flashes.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {}
    </script>

    <slot name="head" />

    <script type="application/ld+json">{
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://pustaka.taratsa.id#organization",
      "name": "Pustaka Taratsa",
      "url": "https://pustaka.taratsa.id",
      "logo": "https://pustaka.taratsa.id/logo-taratsa.png",
      "description": "Perpustakaan digital non-komersil yang mengoleksi dan mengarsip buku langka, zine, serta literatur terkait Indonesia.",
      "sameAs": [
        "https://x.com/taratsa_id",
        "https://www.instagram.com/taratsa.id/"
      ]
    }</script>

    <script type="application/ld+json">{
      "@context": "https://schema.org",
      "@type": "WebSite",
      "url": "https://pustaka.taratsa.id",
      "name": "Pustaka Taratsa",
      "description": "Perpustakaan digital non-komersil yang mengoleksi dan mengarsip buku langka, zine, serta literatur terkait Indonesia.",
      "inLanguage": "id",
      "publisher": { "@id": "https://pustaka.taratsa.id#organization" }
    }</script>

    <script defer src="https://umami.kenadera.org/script.js" data-website-id="0b57aeb6-d996-4d88-89fc-59ada511cd9c" data-performance="true" type="text/javascript"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="brand" aria-label="Beranda Pustaka Taratsa">
          <img src="/logo-taratsa.webp" alt="Pustaka Taratsa" width="28" height="28" fetchpriority="high" loading="eager" style="height:28px;width:auto;" />
          <span>Pustaka Taratsa</span>
        </a>
        <details class="nav-toggle" id="nav-toggle">
          <summary aria-label="Menu navigasi" id="nav-toggle-summary" aria-controls="nav-menu" aria-expanded="false">
            <svg class="hamburger" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </summary>
          <nav id="nav-menu" aria-label="Navigasi utama">
            <details class="nav-group">
              <summary>Koleksi</summary>
              <div class="nav-group__menu">
                <a href="/author">Penulis</a>
                <a href="/series">Seri</a>
                <a href="/publisher">Penerbit</a>
                <a href="/category">Kategori</a>
                <a href="/shelf">Rak</a>
              </div>
            </details>
            <a href="/video/">Video</a>
            <a href="/populer">Populer</a>
            <a href="/about">Tentang Kami</a>
          </nav>
        </details>
        <script>
          const toggle = document.getElementById('nav-toggle');
          const summary = document.getElementById('nav-toggle-summary');
          if (toggle && summary) {
            toggle.addEventListener('toggle', () => {
              summary.setAttribute('aria-expanded', toggle.open);
            });
          }

          const themeBtn = document.getElementById('theme-toggle');
          if (themeBtn) {
            const root = document.documentElement;
            const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
            const current = () => root.dataset.theme || (systemDark.matches ? 'dark' : 'light');
            const sync = () => {
              themeBtn.setAttribute('aria-pressed', String(current() === 'dark'));
            };
            themeBtn.addEventListener('click', () => {
              const next = current() === 'dark' ? 'light' : 'dark';
              root.dataset.theme = next;
              try { localStorage.setItem('theme', next); } catch (e) {}
              sync();
            });
            systemDark.addEventListener('change', sync);
            sync();
          }
        </script>
        <nav class="desktop-nav" aria-label="Navigasi utama">
          <div class="nav-group">
            <a href="/category" class="nav-group__toggle">Koleksi</a>
            <div class="nav-group__menu">
              <a href="/author">Penulis</a>
              <a href="/series">Seri</a>
              <a href="/publisher">Penerbit</a>
              <a href="/category">Kategori</a>
              <a href="/shelf">Rak</a>
            </div>
          </div>
          <a href="/video/">Video</a>
          <a href="/populer">Populer</a>
          <a href="/about">Tentang Kami</a>
        </nav>
        <form action="/search" method="GET" role="search" aria-label="Formulir pencarian">
          <input type="search" name="q" placeholder="Cari buku, penulis…" aria-label="Kata kunci pencarian" />
        </form>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Ganti mode terang/gelap" title="Ganti mode terang/gelap">
          <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/></svg>
        </button>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <p>Pustaka Taratsa — perpustakaan digital non-komersil.</p>
      <p><a href="/admin">Masuk admin</a> · <a href="/opensearch.xml">OpenSearch</a></p>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
