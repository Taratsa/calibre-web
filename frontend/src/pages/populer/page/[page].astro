---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getPopularBooks, paginate } from '~/data';


const pageParam = Astro.params.page;
const books = getPopularBooks();
const totalPages = Math.max(1, Math.ceil(books.length / 30));

if (!pageParam || !/^[1-9]\d*$/.test(pageParam)) {
  return new Response(null, { status: 404 });
}

const pageNum = Number(pageParam);
if (!Number.isSafeInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 });
}

const { items, page, total } = paginate(books, pageNum);
---

<BaseLayout title={`Buku Terpopuler Halaman ${page}`} description={`Halaman ${page} dari ${totalPages} — ${total} buku terpopuler di Pustaka Taratsa`} canonical="/populer" noindex ogType="website">
  <h1>Buku Terpopuler — Halaman {page} dari {totalPages}</h1>
  <p>{total} buku berdasarkan jumlah unduhan.</p>

  <BookGrid books={items} cols={5} />

  <Pagination page={page} totalPages={totalPages} baseUrl="/populer" />
</BaseLayout>
