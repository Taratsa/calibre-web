---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getPopularBooks, paginate } from '~/data';

const books = getPopularBooks();
const { items, page, totalPages, total } = paginate(books, 1);
---

<BaseLayout title="Buku Terpopuler" description="Buku yang paling banyak diunduh di Pustaka Taratsa.">
  <h1>Buku Terpopuler</h1>
  <p>{total} buku berdasarkan jumlah unduhan.</p>

  <BookGrid books={items} cols={5} />

  <Pagination page={page} totalPages={totalPages} baseUrl="/populer" />
</BaseLayout>
