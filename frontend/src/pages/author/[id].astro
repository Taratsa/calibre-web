---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getAllAuthors, booksByAuthor, paginate } from '~/data';
import { authorByPathSegment, authorPath } from '~/utils/author-url';

const { id } = Astro.params;
if (!id || /^\d+$/.test(id)) return new Response(null, { status: 404 });

const resolvedAuthor = authorByPathSegment(id);
const author = resolvedAuthor && getAllAuthors().find((candidate) => candidate.id === resolvedAuthor.id);
if (!author) return new Response(null, { status: 404 });
const baseUrl = `${authorPath(author)}/`;

const all = booksByAuthor(author.id).sort((a, b) =>
  (b.timestamp || '').localeCompare(a.timestamp || '')
);

const { items, page: currentPage, totalPages, total } = paginate(all, 1);

const siteUrl = 'https://pustaka.taratsa.id';
const authorUrl = `${siteUrl}${baseUrl}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  url: authorUrl,
};
---

<BaseLayout title={`Pengarang: ${author.name}`} description={`${author.name} — ${total} buku di Pustaka Taratsa`} canonical={baseUrl} ogType="profile">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <p><a href="/author">‹ Semua pengarang</a></p>
  <h1>{author.name}</h1>
  <p>{total} buku oleh pengarang ini.</p>

  <BookGrid books={items} cols={4} />

  <Pagination page={currentPage} totalPages={totalPages} baseUrl={baseUrl} />
</BaseLayout>
