---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getCategoryById, booksByCategory, paginate } from '~/data';

const { id, page } = Astro.params;
const categoryId = id && /^[1-9]\d*$/.test(id) ? Number(id) : NaN;
const category = Number.isSafeInteger(categoryId) ? getCategoryById(categoryId) : undefined;
if (!category) return new Response(null, { status: 404 });
const pageNum = page && /^[1-9]\d*$/.test(page) ? Number(page) : NaN;

const all = booksByCategory(category.name).sort((a, b) =>
  (b.timestamp || '').localeCompare(a.timestamp || '')
);

const { items, page: p, totalPages, total } = paginate(all, pageNum);

if (!Number.isSafeInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 });
}
---

<BaseLayout title={`Kategori: ${category.name} (Halaman ${p})`} description={`${category.name} — halaman ${p} dari ${totalPages} — ${total} buku dalam kategori ini di Pustaka Taratsa`} canonical={`/category/${category.id}`} noindex ogType="website">
  <p><a href={`/category/${category.id}`}>‹ {category.name}</a></p>
  <h1>{category.name}</h1>
  <p>{total} buku dalam kategori ini.</p>

  <BookGrid books={items} cols={4} />
  <Pagination page={p} totalPages={totalPages} baseUrl={`/category/${category.id}`} />
</BaseLayout>