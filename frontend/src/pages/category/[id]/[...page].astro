---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getAllCategories, booksByCategory, PAGE_SIZE } from '~/data';

export const getStaticPaths = (({ paginate }) => {
  return getAllCategories().flatMap(c => {
    const items = booksByCategory(c.name).sort((x, y) =>
      (y.timestamp || '').localeCompare(x.timestamp || '')
    );
    return paginate(items, {
      params: { id: String(c.id) },
      pageSize: PAGE_SIZE,
      props: { category: c },
    });
  });
}) satisfies GetStaticPaths;

const { page, category } = Astro.props;
const isFirstPage = page.currentPage === 1;
const baseUrl = `/category/${category.id}/`;
---

<BaseLayout title={`Kategori: ${category.name}${isFirstPage ? '' : ` (Halaman ${page.currentPage})`}`} description={`${category.name} — ${page.total} buku dalam kategori ini di Pustaka Taratsa`} canonical={baseUrl} noindex={!isFirstPage}>
  {isFirstPage ? (
    <p><a href="/category">‹ Semua kategori</a></p>
  ) : (
    <p><a href={baseUrl}>‹ {category.name}</a></p>
  )}
  <h1>{category.name}</h1>
  <p>{page.total} buku dalam kategori ini.</p>

  <BookGrid books={page.data} cols={4} />
  <Pagination page={page.currentPage} totalPages={page.lastPage} baseUrl={baseUrl} />
</BaseLayout>