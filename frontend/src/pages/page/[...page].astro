---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getAllBooks, PAGE_SIZE } from '~/data';

export const getStaticPaths = (({ paginate }) => {
  return paginate(getAllBooks(), { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
---

<BaseLayout title={`${isFirstPage ? 'Semua Buku' : `Halaman ${page.currentPage}`}`} description={`${isFirstPage ? 'Semua buku dalam katalog' : `Halaman ${page.currentPage} dari ${page.lastPage}`} — ${page.total} buku di Pustaka Taratsa`} canonical="/page/" noindex={!isFirstPage}>
  {isFirstPage ? <h1>Semua Buku</h1> : <h1>Halaman {page.currentPage} dari {page.lastPage}</h1>}
  <p>{page.total} buku dalam katalog.</p>

  <BookGrid books={page.data} cols={5} />

  <Pagination page={page.currentPage} totalPages={page.lastPage} baseUrl="/page/" />
</BaseLayout>