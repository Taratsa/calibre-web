---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getAllBooks } from '~/data';
import type { BookSummary } from '~/data/types';
import { bookPath } from '~/utils/book-url';

const { id, format } = Astro.params;
const bookId = Number(id);
const requestedFormat = format?.toLowerCase();
if (!Number.isInteger(bookId) || !requestedFormat || !['pdf', 'epub'].includes(requestedFormat)) {
  return new Response(null, { status: 404 });
}

let book: BookSummary | undefined = getAllBooks().find((candidate) => candidate.id === bookId);
if (!book) {
  try {
    book = JSON.parse(readFileSync(join(process.cwd(), 'src', 'data', 'books', `${bookId}.json`), 'utf8')) as BookSummary;
  } catch {}
}
if (!book) return new Response(null, { status: 404 });

const backendUrl = process.env.BACKEND_URL || Astro.url.origin;
const apiUrl = new URL(`/api/read/${book.id}/ocr/${requestedFormat}`, backendUrl);
const requestHeaders = new Headers();
for (const headerName of ['cookie', 'authorization']) {
  const value = Astro.request.headers.get(headerName);
  if (value) requestHeaders.set(headerName, value);
}
const apiResponse = await fetch(apiUrl, {
  headers: requestHeaders,
  redirect: 'manual',
});

if ((apiResponse.status >= 300 && apiResponse.status < 400) || apiResponse.status === 401 || apiResponse.status === 403) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`, 302);
}
if (apiResponse.status === 404) return new Response(null, { status: 404 });

let payload: {
  error?: string;
  book?: { id: number; title: string };
  document?: {
    markdown_html: string;
    page_count: number;
    pages_routed_to_ocr: number;
    processing_time_ms: number;
  };
  state?: { status: string; pages_done?: number; pages_total?: number };
} = {};
try {
  payload = await apiResponse.json();
} catch {}
// 202 = not processed yet: the page offers to queue it instead of failing.
const pending = apiResponse.status === 202;
if (!pending && (!apiResponse.ok || !payload.document)) {
  const status = apiResponse.status || 503;
  const message = payload.error ?? 'OCR is not available for this document.';
  return new Response(message, { status, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}

const { document } = payload;
const jobState = payload.state;
const pendingMessage =
  jobState?.status === 'queued' ? 'Dokumen sedang menunggu giliran diproses…'
  : jobState?.status === 'processing'
    ? jobState.pages_total ? `Sedang diproses: ${jobState.pages_done} dari ${jobState.pages_total} halaman…` : 'Sedang diproses…'
  : jobState?.status === 'failed' ? 'Pemrosesan gagal. Server OCR mungkin sedang tidak tersedia; coba lagi sebentar lagi.'
  : 'Dokumen ini belum diproses OCR. Untuk dokumen besar, prosesnya bisa memakan beberapa menit.';
const bookUrl = `${bookPath(book)}/`;
const originalUrl = `/read/${book.id}/${requestedFormat}`;
const formatLabel = requestedFormat.toUpperCase();
// Only PDFs go through OCR; EPUB text is read straight from the file.
const isOcr = requestedFormat === 'pdf';
// Same wording as the book page button. The format stays in the title so a book's PDF and EPUB pages differ.
const readHeading = `Baca teks (${formatLabel})`;
const totalSeconds = Math.round((document?.processing_time_ms ?? 0) / 1000);
const duration = totalSeconds < 60
  ? `${((document?.processing_time_ms ?? 0) / 1000).toFixed(1)} detik`
  : `${Math.floor(totalSeconds / 60)} mnt ${totalSeconds % 60} dtk`;
const metaParts = document
  ? [
      `${document.page_count} ${isOcr ? 'halaman' : 'bagian'}`,
      ...(isOcr
        ? [document.pages_routed_to_ocr > 0
            ? `${document.pages_routed_to_ocr} halaman diproses dengan OCR`
            : `teks ${formatLabel} berhasil diekstrak tanpa OCR`]
        : []),
      ...(isOcr ? [duration] : []),
    ]
  : [];
const decodeEntities = (value: string) => value
  .replace(/&#(\d+);/g, (_, code) => String.fromCodePoint(Number(code)))
  .replace(/&#x([\da-f]+);/gi, (_, code) => String.fromCodePoint(Number.parseInt(code, 16)))
  .replace(/&nbsp;/g, ' ')
  .replace(/&amp;/g, '&')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'");
// EPUB text keeps its own relative links ("Section0006.xhtml", "text/bab12.xhtml"). Resolved against this page they are
// dead 404 URLs that crawlers collect, so links that are neither absolute, root-relative nor in-page are unwrapped.
const unwrapRelativeLinks = (html: string) => html.replace(
  /<a\b[^>]*?\shref=(["'])(.*?)\1[^>]*>([\s\S]*?)<\/a>/gi,
  (whole, _quote: string, href: string, inner: string) =>
    /^\s*(?:[a-z][a-z0-9+.-]*:|\/|#|$)/i.test(href) ? whole : inner,
);
const headingIds = new Map<string, number>();
const toc: Array<{ id: string; level: number; text: string }> = [];
// Output level of the previous heading; the page title is the h1, so the first document heading may be an h2 at most.
let previousOutLevel = 1;
const contentHtml = unwrapRelativeLinks(document?.markdown_html ?? '').replace(
  /<(h[1-6])([^>]*)>([\s\S]*?)<\/\1>/gi,
  (_, tag: string, attributes: string, content: string) => {
    // The page title is the only <h1>: document headings are demoted one level (h6 stays h6), and never jump more
    // than one level below the previous heading (WCAG 1.3.1 / best practice heading-order).
    const level = Number(tag.slice(1));
    const outLevel = Math.min(6, level + 1, previousOutLevel + 1);
    previousOutLevel = outLevel;
    const outTag = `h${outLevel}`;
    const text = decodeEntities(content.replace(/<[^>]*>/g, '')).replace(/\s+/g, ' ').trim();
    if (!text) return `<${outTag}${attributes}>${content}</${outTag}>`;
    const baseId = text.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'bagian';
    const occurrence = (headingIds.get(baseId) || 0) + 1;
    headingIds.set(baseId, occurrence);
    const id = occurrence === 1 ? baseId : `${baseId}-${occurrence}`;
    toc.push({ id, level, text });
    return `<${outTag}${attributes} id="${id}">${content}</${outTag}>`;
  },
);
// Unique per-page description (title, authors, start of the text) instead of the site-wide default.
const authorNames = book.authors.map((author) => author.name).join(', ');
const lead = `${book.title}${authorNames ? ` — ${authorNames}` : ''}. `;
const plainText = decodeEntities(contentHtml.replace(/<[^>]*>/g, ' ')).replace(/\s+/g, ' ').trim();
const ocrDescription = document && plainText
  ? `${lead}${plainText.slice(0, Math.max(40, 158 - lead.length)).trimEnd()}…`
  : undefined;
---

<BaseLayout title={`${readHeading}: ${book.title}`} description={ocrDescription} canonical={`/read/${book.id}/ocr/${requestedFormat}/`} ogType="article" noindex={pending}>
  <script slot="head" is:inline>
    // Applied before first paint so stored reader settings never flash. Keep the values in sync with the page script.
    try {
      var scale = parseFloat(localStorage.getItem('ocr-font-scale'));
      if ([0.85, 1, 1.15, 1.3, 1.5, 1.75].indexOf(scale) >= 0) document.documentElement.style.setProperty('--ocr-scale', String(scale));
      if (localStorage.getItem('ocr-text-align') === 'justify') document.documentElement.setAttribute('data-ocr-align', 'justify');
    } catch (e) {}
  </script>
  <div class="ocr-reader">
    <nav class="ocr-reader__toolbar" aria-label="Alat pembaca">
      <a href={bookUrl}>← Kembali ke buku</a>
      <a href={originalUrl} target="_blank" rel="noopener noreferrer">Buka dokumen asli</a>
      {!pending && (
        <div class="ocr-reader__tools">
          <div class="ocr-reader__segmented" role="group" aria-label="Ukuran teks" data-fontsize>
            <button type="button" data-fontsize-down aria-label="A−, perkecil teks">A−</button>
            <button type="button" data-fontsize-reset aria-label="100%, atur ulang ukuran teks" title="Atur ulang ukuran teks">100%</button>
            <button type="button" data-fontsize-up aria-label="A+, perbesar teks">A+</button>
          </div>
          <div class="ocr-reader__segmented" role="group" aria-label="Perataan teks" data-align>
            <button type="button" data-align-value="left" aria-label="Rata kiri" title="Rata kiri" aria-pressed="true">
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 5h14M3 9h9M3 13h14M3 17h9" /></svg>
            </button>
            <button type="button" data-align-value="justify" aria-label="Rata kiri-kanan" title="Rata kiri-kanan" aria-pressed="false">
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 5h14M3 9h14M3 13h14M3 17h14" /></svg>
            </button>
          </div>
          <div class="ocr-reader__segmented" role="group" aria-label="Unduh teks" data-download data-title={book.title} data-authors={authorNames} data-format={requestedFormat} data-ocr={String(isOcr)}>
            <button type="button" data-download-format="txt" title="Unduh sebagai teks biasa (.txt)">Unduh .txt</button>
            <button type="button" data-download-format="md" title="Unduh sebagai Markdown (.md)">Unduh .md</button>
          </div>
        </div>
      )}
    </nav>
    <header class="ocr-reader__header">
      <h1 id="ocr-top">{readHeading}: {book.title}</h1>
      {!pending && <p class="ocr-reader__meta">{metaParts.join(' · ')}</p>}
      {!pending && (
        <p class="ocr-reader__notice" role="note">
          {isOcr
            ? 'Versi OCR mungkin terdapat kesalahan eja, ketik, tata letak, atau hal terkait tipografi. Untuk ketepatan hasil, silakan merujuk pada '
            : 'Teks ini diambil langsung dari berkas EPUB; tata letak dan gambar tidak disertakan. Untuk tampilan lengkap, silakan merujuk pada '}
          <a href={originalUrl} target="_blank" rel="noopener noreferrer">dokumen asli</a>.
        </p>
      )}
    </header>
    {pending ? (
      <section class="ocr-pending" data-ocr-pending data-book-id={book.id} data-format={requestedFormat} data-status={jobState?.status ?? 'idle'}>
        <p data-ocr-message role="status" aria-live="polite">{pendingMessage}</p>
        <progress data-ocr-progress hidden></progress>
        <button type="button" data-ocr-start hidden={jobState?.status === 'queued' || jobState?.status === 'processing'}>
          {jobState?.status === 'failed' ? 'Coba lagi' : 'Mulai proses OCR'}
        </button>
      </section>
    ) : (
      <>
        <div class="ocr-progress" data-progress data-title={book.title}>
          <nav class="ocr-progress__bar" aria-label="Posisi membaca">
            <ol class="ocr-progress__chain" data-progress-chain></ol>
            <span class="ocr-progress__percent" data-progress-percent aria-hidden="true">0%</span>
            <span class="ocr-progress__line" data-progress-line aria-hidden="true"></span>
          </nav>
        </div>
        {toc.length > 0 && (
          <details class="ocr-reader__toc">
            <summary>Daftar isi</summary>
            <ol>
              {toc.map(item => (
                <li style={`--toc-level: ${item.level}`}><a href={`#${item.id}`}>{item.text}</a></li>
              ))}
            </ol>
          </details>
        )}
        <article class="ocr-reader__content" set:html={contentHtml} />
        <button class="ocr-reader__top" type="button" aria-label="Kembali ke atas" data-scroll-top>
          ↑ <span>Kembali ke atas</span>
        </button>
      </>
    )}
  </div>
</BaseLayout>

<script>
  const pending = document.querySelector<HTMLElement>('[data-ocr-pending]');
  if (pending) {
    const { bookId, format } = pending.dataset;
    const message = pending.querySelector<HTMLElement>('[data-ocr-message]')!;
    const bar = pending.querySelector<HTMLProgressElement>('[data-ocr-progress]')!;
    const start = pending.querySelector<HTMLButtonElement>('[data-ocr-start]')!;
    type State = { status: string; pages_done?: number; pages_total?: number } | null;
    let timer: number | undefined;

    // A plain reload could return the cached "not processed" page again; a unique query string cannot be cached.
    const reloadFresh = () => {
      const url = new URL(location.href);
      url.searchParams.set('r', String(Date.now()));
      location.replace(url);
    };

    const render = (state: State) => {
      const status = state?.status ?? 'idle';
      start.hidden = status === 'queued' || status === 'processing';
      start.disabled = false;
      start.textContent = status === 'failed' ? 'Coba lagi' : 'Mulai proses OCR';
      bar.hidden = status !== 'processing' || !state?.pages_total;
      if (!bar.hidden) {
        bar.max = state!.pages_total!;
        bar.value = state!.pages_done ?? 0;
      }
      message.textContent =
        status === 'queued' ? 'Dokumen sedang menunggu giliran diproses…'
        : status === 'processing'
          ? state?.pages_total ? `Sedang diproses: ${state.pages_done} dari ${state.pages_total} halaman…` : 'Sedang diproses…'
        : status === 'failed' ? 'Pemrosesan gagal. Server OCR mungkin sedang tidak tersedia; coba lagi sebentar lagi.'
        : 'Dokumen ini belum diproses OCR. Untuk dokumen besar, prosesnya bisa memakan beberapa menit.';
    };

    const poll = async () => {
      try {
        const response = await fetch(`/api/read/${bookId}/ocr/status/${format}`, { credentials: 'same-origin', cache: 'no-store' });
        if (response.ok) {
          const body = (await response.json()) as { available: boolean; state: State };
          if (body.available) return reloadFresh();
          render(body.state);
          if (body.state && (body.state.status === 'queued' || body.state.status === 'processing')) {
            timer = window.setTimeout(poll, 3000);
          }
          return;
        }
      } catch {}
      timer = window.setTimeout(poll, 6000);
    };

    start.addEventListener('click', async () => {
      start.disabled = true;
      window.clearTimeout(timer);
      try {
        const response = await fetch(`/api/read/${bookId}/ocr/${format}`, { method: 'POST', credentials: 'same-origin' });
        const body = (await response.json()) as { state?: State; error?: string };
        if (response.status === 429 || !response.ok) {
          start.disabled = false;
          message.textContent = response.status === 429
            ? 'Terlalu banyak dokumen sedang diproses. Coba lagi dalam beberapa menit.'
            : 'OCR tidak tersedia untuk dokumen ini.';
          return;
        }
        if (body.state?.status === 'done') return reloadFresh();
        render(body.state ?? null);
        timer = window.setTimeout(poll, 3000);
      } catch {
        start.disabled = false;
        message.textContent = 'Gagal menghubungi server. Coba lagi.';
      }
    });

    // The page may be a stale copy cached at the edge, so always check once instead of trusting data-status.
    const active = pending.dataset.status === 'queued' || pending.dataset.status === 'processing';
    timer = window.setTimeout(poll, active ? 3000 : 0);
  }
</script>

<script>
  const scrollTopButton = document.querySelector<HTMLButtonElement>('[data-scroll-top]');
  if (scrollTopButton) {
    const updateVisibility = () => {
      scrollTopButton.toggleAttribute('data-visible', window.scrollY > 480);
    };
    scrollTopButton.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
    updateVisibility();
    window.addEventListener('scroll', updateVisibility, { passive: true });
  }
</script>

<script>
  const group = document.querySelector<HTMLElement>('[data-fontsize]');
  if (group) {
    // Keep in sync with the inline pre-paint script in <head>.
    const steps = [0.85, 1, 1.15, 1.3, 1.5, 1.75];
    const key = 'ocr-font-scale';
    const smaller = group.querySelector<HTMLButtonElement>('[data-fontsize-down]')!;
    const larger = group.querySelector<HTMLButtonElement>('[data-fontsize-up]')!;
    const reset = group.querySelector<HTMLButtonElement>('[data-fontsize-reset]')!;
    let index = 1;
    try {
      const stored = steps.indexOf(parseFloat(localStorage.getItem(key) ?? ''));
      if (stored >= 0) index = stored;
    } catch {}

    const apply = () => {
      const scale = steps[index];
      document.documentElement.style.setProperty('--ocr-scale', String(scale));
      reset.textContent = `${Math.round(scale * 100)}%`;
      reset.setAttribute('aria-label', `${Math.round(scale * 100)}%, atur ulang ukuran teks`);
      smaller.disabled = index === 0;
      larger.disabled = index === steps.length - 1;
      try {
        if (index === 1) localStorage.removeItem(key);
        else localStorage.setItem(key, String(scale));
      } catch {}
    };
    smaller.addEventListener('click', () => { index = Math.max(0, index - 1); apply(); });
    larger.addEventListener('click', () => { index = Math.min(steps.length - 1, index + 1); apply(); });
    reset.addEventListener('click', () => { index = 1; apply(); });
    apply();
  }
</script>

<script>
  const group = document.querySelector<HTMLElement>('[data-align]');
  if (group) {
    // Keep in sync with the inline pre-paint script in <head>. Left is the default and stores nothing.
    const key = 'ocr-text-align';
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-align-value]')];
    const apply = (value: string) => {
      if (value === 'justify') document.documentElement.setAttribute('data-ocr-align', 'justify');
      else document.documentElement.removeAttribute('data-ocr-align');
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.alignValue === value));
      try {
        if (value === 'justify') localStorage.setItem(key, value);
        else localStorage.removeItem(key);
      } catch {}
    };
    for (const button of buttons) button.addEventListener('click', () => apply(button.dataset.alignValue ?? 'left'));
    apply(document.documentElement.getAttribute('data-ocr-align') === 'justify' ? 'justify' : 'left');
  }
</script>

<script>
  // Download the text as it is shown, converted from the rendered article: the API only returns sanitised HTML.
  const group = document.querySelector<HTMLElement>('[data-download]');
  const article = document.querySelector<HTMLElement>('.ocr-reader__content');
  if (group && article) {
    type Mode = 'md' | 'txt';
    const BLOCKS = new Set([
      'P', 'DIV', 'ASIDE', 'SECTION', 'ARTICLE', 'BLOCKQUOTE', 'UL', 'OL', 'LI', 'TABLE', 'PRE', 'HR', 'FIGURE',
      'FIGCAPTION', 'DL', 'DT', 'DD', 'NAV', 'HEADER', 'FOOTER', 'MAIN', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6',
    ]);
    const squash = (value: string) => value.replace(/\s+/g, ' ');
    // Emphasis marks hug the text: "a *b* c", never "a * b * c".
    const wrap = (text: string, mark: string) => {
      const core = text.trim();
      if (!core) return text;
      return `${text.slice(0, text.length - text.trimStart().length)}${mark}${core}${mark}${text.slice(text.trimEnd().length)}`;
    };

    const inline = (node: Node, mode: Mode): string => {
      if (node.nodeType === Node.TEXT_NODE) return squash(node.textContent ?? '');
      if (!(node instanceof Element)) return '';
      const tag = node.tagName;
      if (tag === 'SCRIPT' || tag === 'STYLE') return '';
      if (tag === 'BR') return mode === 'md' ? '  \n' : '\n';
      if (tag === 'IMG') {
        const alt = node.getAttribute('alt')?.trim() ?? '';
        const src = (node as HTMLImageElement).src;
        return mode === 'md' && alt && src && !src.startsWith('data:') ? `![${alt}](${src})` : alt;
      }
      const inner = [...node.childNodes].map((child) => inline(child, mode)).join('');
      if (mode === 'txt') return inner;
      if (tag === 'STRONG' || tag === 'B') return wrap(inner, '**');
      if (tag === 'EM' || tag === 'I') return wrap(inner, '*');
      if (tag === 'CODE') return wrap(inner, '`');
      if (tag === 'A') {
        const href = node.getAttribute('href') ?? '';
        // In-page anchors mean nothing outside this page.
        if (!href || href.startsWith('#') || !inner.trim()) return inner;
        return `[${inner.trim()}](${(node as HTMLAnchorElement).href})`;
      }
      return inner;
    };

    // Children of a container as blocks (paragraphs): consecutive inline nodes form one block.
    const blocks = (parent: Element, mode: Mode): string[] => {
      const out: string[] = [];
      let run = '';
      const flush = () => {
        const text = run.replace(/\n +/g, '\n').trim();
        if (text) out.push(text);
        run = '';
      };
      for (const child of parent.childNodes) {
        if (child instanceof Element && BLOCKS.has(child.tagName)) {
          flush();
          out.push(...block(child, mode));
        } else {
          run += inline(child, mode);
        }
      }
      flush();
      return out;
    };

    const quote = (inner: string[], mode: Mode) => inner
      .join('\n\n')
      .split('\n')
      .map((line) => (mode === 'md' ? (line ? `> ${line}` : '>') : line ? `    ${line}` : ''))
      .join('\n');

    const list = (el: Element, mode: Mode): string[] => {
      let number = Number((el as HTMLOListElement).start) || 1;
      const items: string[] = [];
      for (const item of el.children) {
        if (item.tagName !== 'LI') continue;
        const body = blocks(item, mode).join('\n').split('\n');
        if (!body.join('').trim()) continue;
        const marker = el.tagName === 'OL' ? `${number++}. ` : '- ';
        items.push(marker + body.map((line, index) => (index ? `${' '.repeat(marker.length)}${line}` : line)).join('\n'));
      }
      return items.length ? [items.join('\n')] : [];
    };

    const table = (el: Element, mode: Mode): string[] => {
      const rows = [...el.querySelectorAll('tr')]
        .map((row) => [...row.children]
          .filter((cell) => cell.tagName === 'TH' || cell.tagName === 'TD')
          .map((cell) => {
            const text = squash(blocks(cell, mode).join(' ')).trim();
            return mode === 'md' ? text.replace(/\|/g, '\\|') : text;
          }))
        .filter((cells) => cells.length);
      const width = Math.max(0, ...rows.map((cells) => cells.length));
      if (!width) return [];
      const padded = rows.map((cells) => [...cells, ...new Array<string>(width - cells.length).fill('')]);
      if (mode === 'txt') return [padded.map((cells) => cells.join(' | ').trimEnd()).join('\n')];
      const line = (cells: string[]) => `| ${cells.join(' | ')} |`;
      return [[line(padded[0]), line(new Array<string>(width).fill('---')), ...padded.slice(1).map(line)].join('\n')];
    };

    const block = (el: Element, mode: Mode): string[] => {
      const tag = el.tagName;
      if (tag.length === 2 && tag[0] === 'H') {
        const text = squash(inline(el, mode)).trim();
        if (!text) return [];
        return [mode === 'md' ? `${'#'.repeat(Number(tag[1]))} ${text}` : text];
      }
      if (tag === 'HR') return [mode === 'md' ? '---' : '* * *'];
      if (tag === 'PRE') {
        const text = (el.textContent ?? '').trimEnd();
        if (!text.trim()) return [];
        return [mode === 'md' ? `\`\`\`\n${text}\n\`\`\`` : text];
      }
      if (tag === 'UL' || tag === 'OL') return list(el, mode);
      if (tag === 'TABLE') return table(el, mode);
      const inner = blocks(el, mode);
      if (!inner.length) return [];
      if (tag === 'BLOCKQUOTE' || el.classList.contains('ocr-footnotes')) return [quote(inner, mode)];
      return inner;
    };

    const title = group.dataset.title ?? '';
    const authors = group.dataset.authors ?? '';
    const build = (mode: Mode) => {
      const head = [mode === 'md' ? `# ${title}` : title];
      if (authors) head.push(`Penulis: ${authors}`);
      head.push(`Sumber: ${location.origin}${location.pathname}`);
      if (group.dataset.ocr === 'true') head.push('Teks hasil OCR dapat mengandung kesalahan eja dan tata letak.');
      if (mode === 'md') head.push('---');
      return `${[...head, ...blocks(article, mode)].join('\n\n')}\n`;
    };
    const slug = title.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80).replace(/-$/, '')
      || 'buku';

    for (const button of group.querySelectorAll<HTMLButtonElement>('[data-download-format]')) {
      button.addEventListener('click', () => {
        const mode: Mode = button.dataset.downloadFormat === 'md' ? 'md' : 'txt';
        const blob = new Blob([build(mode)], { type: `${mode === 'md' ? 'text/markdown' : 'text/plain'};charset=utf-8` });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `${slug}-${group.dataset.format ?? 'teks'}.${mode}`;
        document.body.append(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 10000);
      });
    }
  }
</script>

<script>
  const wrapper = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('.ocr-reader__content');
  if (wrapper && article) {
    const chain = wrapper.querySelector<HTMLElement>('[data-progress-chain]')!;
    const percent = wrapper.querySelector<HTMLElement>('[data-progress-percent]')!;
    const line = wrapper.querySelector<HTMLElement>('[data-progress-line]')!;
    const bookTitle = wrapper.dataset.title ?? '';
    const headings = [...article.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id], h5[id], h6[id]')];
    const levelOf = (heading: HTMLElement) => Number(heading.tagName.slice(1));
    // Ancestors of every heading (the heading itself last), built once from the heading levels.
    const stack: number[] = [];
    const trails = headings.map((heading, index) => {
      while (stack.length && levelOf(headings[stack[stack.length - 1]]) >= levelOf(heading)) stack.pop();
      stack.push(index);
      return [...stack];
    });
    let tops: number[] = [];
    let shown = -2;
    let frame = 0;

    const render = (current: number) => {
      shown = current;
      chain.replaceChildren();
      const items: Array<[string, string]> = [['#ocr-top', bookTitle]];
      if (current >= 0) {
        for (const index of trails[current]) items.push([`#${headings[index].id}`, headings[index].textContent?.trim() ?? '']);
      }
      for (const [href, text] of items) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = href;
        link.textContent = text;
        item.append(link);
        chain.append(item);
      }
      chain.lastElementChild?.querySelector('a')?.setAttribute('aria-current', 'location');
    };
    const update = () => {
      frame = 0;
      const scrollY = window.scrollY;
      // The section the reader is in: the last heading at or above the point a jump to a heading lands on
      // (its scroll-margin-top, which clears the sticky bars), so following a link selects that heading.
      const probe = scrollY + landing + 2;
      let low = 0;
      let high = tops.length - 1;
      let current = -1;
      while (low <= high) {
        const middle = (low + high) >> 1;
        if (tops[middle] <= probe) { current = middle; low = middle + 1; } else high = middle - 1;
      }
      if (current !== shown) render(current);
      const start = article.getBoundingClientRect().top + scrollY;
      const span = Math.max(1, article.offsetHeight - window.innerHeight);
      const done = Math.min(1, Math.max(0, (scrollY - start) / span));
      percent.textContent = `${Math.round(done * 100)}%`;
      line.style.transform = `scaleX(${done})`;
    };
    const landing = headings.length ? parseFloat(getComputedStyle(headings[0]).scrollMarginTop) || 0 : 0;
    const measure = () => {
      tops = headings.map((heading) => heading.getBoundingClientRect().top + window.scrollY);
      update();
    };

    window.addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', measure);
    // Text size, alignment and late-loading images all move the headings.
    new ResizeObserver(measure).observe(article);
    measure();
  }
</script>

