---
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getAllPublishers, booksByPublisher, paginate, PAGE_SIZE } from '~/data';

export async function getStaticPaths() {
  const out = [];
  for (const p of getAllPublishers()) {
    const total = Math.ceil(booksByPublisher(p.id).length / PAGE_SIZE);
    for (let page = 2; page <= total; page++) {
      out.push({ params: { id: String(p.id), page: String(page) } });
    }
  }
  return out;
}

const { id, page } = Astro.params;
const publisher = getAllPublishers().find(p => p.id === Number(id));
if (!publisher) return Astro.redirect('/publisher');
const pageNum = Number(page);

const all = booksByPublisher(publisher.id).sort((a, b) =>
  (b.timestamp || '').localeCompare(a.timestamp || '')
);

const { items, page: p, totalPages, total } = paginate(all, pageNum);
---

<BookGrid books={items} cols={4} />
<Pagination page={p} totalPages={totalPages} baseUrl={`/publisher/${publisher.id}`} />