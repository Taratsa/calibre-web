---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getAllPublishers, booksByPublisher, paginate } from '~/data';

const { id, page } = Astro.params;
const publisher = getAllPublishers().find(p => String(p.id) === id);
if (!publisher) return new Response(null, { status: 404 });
const pageNum = page && /^[1-9]\d*$/.test(page) ? Number(page) : NaN;

const all = booksByPublisher(publisher.id).sort((a, b) =>
  (b.timestamp || '').localeCompare(a.timestamp || '')
);

const { items, page: p, totalPages, total } = paginate(all, pageNum);

if (!Number.isSafeInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 });
}
---

<BaseLayout title={`Penerbit: ${publisher.name} (Halaman ${p})`} description={`${publisher.name} — halaman ${p} dari ${totalPages} — ${total} buku dari penerbit ini di Pustaka Taratsa`} canonical={`/publisher/${publisher.id}`} noindex ogType="website">
  <p><a href={`/publisher/${publisher.id}`}>‹ {publisher.name}</a></p>
  <h1>{publisher.name}</h1>
  <p>{total} buku dari penerbit ini.</p>

  <BookGrid books={items} cols={4} />
  <Pagination page={p} totalPages={totalPages} baseUrl={`/publisher/${publisher.id}`} />
</BaseLayout>