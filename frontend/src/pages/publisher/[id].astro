---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getAllPublishers, booksByPublisher, paginate } from '~/data';

const { id } = Astro.params;
const publisher = getAllPublishers().find(p => String(p.id) === id);
if (!publisher) return new Response(null, { status: 404 });

const all = booksByPublisher(publisher.id).sort((a, b) =>
  (b.timestamp || '').localeCompare(a.timestamp || '')
);

const { items, page: p, totalPages, total } = paginate(all, 1);
---

<BaseLayout title={`Penerbit: ${publisher.name}`} description={`${publisher.name} — ${total} buku dari penerbit ini di Pustaka Taratsa`}>
  <p><a href="/publisher">‹ Semua penerbit</a></p>
  <h1>{publisher.name}</h1>
  <p>{total} buku dari penerbit ini.</p>

  <BookGrid books={items} cols={4} />

  <Pagination page={p} totalPages={totalPages} baseUrl={`/publisher/${publisher.id}`} />
</BaseLayout>
