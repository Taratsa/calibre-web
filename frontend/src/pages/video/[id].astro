---
import BaseLayout from '../../layouts/BaseLayout.astro'
import VideoCard from '../../components/VideoCard.astro'
import { videos as allVideos, decodeEntities } from '../../data/videos'
import { getTranscript, formatTimestamp } from '../../data/video-transcripts'

const { id } = Astro.params
const video = id ? allVideos.find((item) => item.id === id) : undefined
if (!video) return new Response(null, { status: 404 })

const description = video.providerDescription || 'Deskripsi YouTube belum tersedia.'
const posted = new Date(video.date)
const dateLabel = Number.isNaN(posted.valueOf())
  ? video.date.slice(0, 10)
  : posted.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })

const samePost = allVideos.filter((item) => item.postId === video.postId && item.id !== video.id).slice(0, 6)
const fallback = allVideos.filter((item) => item.id !== video.id).slice(0, 6)
const related = samePost.length ? samePost : fallback
const transcript = video.type === 'youtube' ? getTranscript(video.id) : null
---

<BaseLayout title={`${video.providerTitle} | Video`} description={description.slice(0, 200)} canonical={`/video/${video.id}/`} ogType="article">
  <p class="back"><a href="/video/">← Kembali ke Video</a></p>

  <article class="video-detail">
    <div class="video-player">
      {video.type === 'youtube' && (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${encodeURIComponent(video.id)}?rel=0`}
          title={video.providerTitle}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        />
      )}
      {video.type === 'vimeo' && (
        <iframe
          src={`https://player.vimeo.com/video/${encodeURIComponent(video.id)}`}
          title={video.title}
          loading="lazy"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        />
      )}
      {video.type === 'video' && <video controls preload="metadata" src={video.embedUrl} />}
    </div>

    <h1>{video.providerTitle}</h1>
    <p class="video-meta">
      {dateLabel} · {video.sourceLabel} ·
      <a href={video.channelUrl} target="_blank" rel="noopener noreferrer">{video.channel}</a>
    </p>
    {description && <p class="video-desc">{description}{description.length >= 400 ? '…' : ''}</p>}
    <p class="video-source">
      Sumber artikel:
      <a href={video.sourceUrl} target="_blank" rel="noopener noreferrer">{video.sourceUrl}</a>
    </p>

    {transcript && (
      <section class="transcript" aria-labelledby="transcript-heading">
        <details>
          <summary id="transcript-heading">
            Subtitel{transcript.lang?.startsWith('en') ? ' (bahasa Inggris)' : ''}
          </summary>
          <ol>
            {transcript.lines.map(([seconds, text]) => (
              <li>
                <a class="transcript__time" href={`${video.watchUrl}&t=${seconds}s`} target="_blank" rel="noopener noreferrer">{formatTimestamp(seconds)}</a>
                <span>{text}</span>
              </li>
            ))}
          </ol>
        </details>
      </section>
    )}
  </article>

  {related.length > 0 && (
    <section class="related">
      <h2>Video lainnya</h2>
      <ul class="video-grid">
        {related.map((item) => <VideoCard video={item} />)}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .back { margin: 0 0 1rem; }
  .video-detail { max-width: 60rem; }
  .video-player { aspect-ratio: 16 / 9; width: 100%; margin-bottom: 1.5rem; border-radius: 4px; background: #000; overflow: hidden; box-shadow: 0 1px 4px var(--shadow-sm); }
  .video-player iframe, .video-player video { width: 100%; height: 100%; border: 0; display: block; }
  .video-meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 1.25rem; }
  .video-desc { max-width: 48rem; line-height: 1.65; }
  .video-source { margin-top: 1.25rem; overflow-wrap: anywhere; }
  .transcript { max-width: 48rem; margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1rem; }
  .transcript summary { cursor: pointer; font-weight: 600; }
  .transcript ol { list-style: none; margin: 1rem 0 0; padding: 0; max-height: 32rem; overflow-y: auto; }
  .transcript li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.75rem; padding: 0.4rem 0; line-height: 1.65; }
  .transcript__time { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.85rem; text-decoration: none; }
  .related { margin-top: 3rem; }
  .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem; margin: 1.5rem 0; padding: 0; list-style: none; }
</style>
