---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BookLayout from '~/layouts/BookLayout.astro';
import Cover from '~/components/Cover.astro';
import BookGrid from '~/components/BookGrid.astro';
import { getAllBooks, getAllCategories, formatBytes, getShelves } from '~/data';
import type { BookDetail } from '~/data/types';
import { authorPath } from '~/utils/author-url';
import { bookByPathSegment, bookPath } from '~/utils/book-url';
import { reliablePubdate } from '~/utils/pubdate';

const { id } = Astro.params;
if (!id || /^\d+$/.test(id)) return new Response(null, { status: 404 });

const resolvedBook = bookByPathSegment(id);
const book = resolvedBook && getAllBooks().find((candidate) => candidate.id === resolvedBook.id);
if (!book) return new Response(null, { status: 404 });
if (id !== book.slug) return Astro.redirect(`${bookPath(book)}/`, 308);

const contentDir = join(process.cwd(), 'src', 'data', 'books');
let detail: BookDetail | null = null;
try {
  detail = JSON.parse(readFileSync(join(contentDir, `${book.id}.json`), 'utf8'));
} catch {}

const baseUrl = `${bookPath(book)}/`;

const commentText = detail?.comment || '';
const cleanComment = commentText.replace(/<[^>]+>/g, '').trim();
const sizes = new Map<string, number>();
if (detail?.data) {
  for (const d of detail.data) sizes.set(d.format.toLowerCase(), d.size || 0);
}

const readableExt = new Set(['epub', 'pdf', 'txt', 'cbr', 'cbz', 'djvu', 'mp3']);
const readUrl = book.formats.find(f => readableExt.has(f.toLowerCase()));
const ocrFormats = book.formats.filter(f => ['pdf', 'epub'].includes(f.toLowerCase()));
const ocrUrls = new Map<string, { href: string; label: string }>();
for (const format of ocrFormats) {
  try {
    const normalizedFormat = format.toLowerCase();
    const statusUrl = new URL(`/api/read/${book.id}/ocr/status/${normalizedFormat}`, process.env.BACKEND_URL || Astro.url.origin);
    const statusHeaders = new Headers();
    for (const headerName of ['cookie', 'authorization']) {
      const value = Astro.request.headers.get(headerName);
      if (value) statusHeaders.set(headerName, value);
    }
    const statusResponse = await fetch(statusUrl, { headers: statusHeaders, redirect: 'manual' });
    if (statusResponse.ok) {
      const status = await statusResponse.json() as { available?: boolean; state?: { status?: string } | null };
      const upper = normalizedFormat.toUpperCase();
      // Every readable format is linked: an unprocessed PDF opens a page that queues the OCR job on demand.
      // EPUB text is read straight from the file (no OCR), so its link is always the plain text page.
      const inProgress = status.state?.status === 'queued' || status.state?.status === 'processing';
      // A book with both a PDF and an EPUB gets two text links, so the format is added to tell them apart.
      const readLabel = ocrFormats.length > 1 ? `Baca teks (${upper})` : 'Baca teks';
      const label = normalizedFormat === 'epub' || status.available === true ? readLabel
        : inProgress ? `${upper} sedang diproses OCR…`
        : `Proses ${upper} dengan OCR`;
      // An EPUB whose text cannot be extracted (corrupt file) has no text page: do not link a 404.
      if (normalizedFormat === 'epub' && status.available !== true) continue;
      ocrUrls.set(normalizedFormat, { href: `/read/${book.id}/ocr/${normalizedFormat}/`, label });
    }
  } catch {}
}

const buttons = book.formats.map(f => ({
  href: `/download/${book.id}/${f.toLowerCase()}`,
  label: f.toUpperCase(),
  sizeText: (() => { const s = sizes.get(f.toLowerCase()); return s ? `(${formatBytes(s)})` : ''; })(),
}));

const authorStr = book.authors.map(a => `<a href="${authorPath(a)}/">${a.name}</a>`).join(', ');
const cats = getAllCategories();
// Public shelves containing this book (app.db data, seeded into shelves.json).
const bookShelves = getShelves().filter(s => s.book_ids.includes(book.id));
const shelfStr = bookShelves.map(s =>
  `<li><a href="/shelf/${s.id}/">${s.name.trim()}</a></li>`
).join('');
const tagStr = book.tags.map(t => {
  const cat = cats.find(c => c.name === t);
  return `<li><a href="/category/${cat ? cat.id : encodeURIComponent(t)}/">${t}</a></li>`;
}).join('');
// Comma-joined category links for the labeled metadata row.
const catLinks = book.tags.map(t => {
  const cat = cats.find(c => c.name === t);
  return `<a href="/category/${cat ? cat.id : encodeURIComponent(t)}/">${t}</a>`;
}).join(', ');

const langLinks = book.languages.map(c =>
  `<a href="/language/${c}/">${c}</a>`
).join(', ');

const identStr = book.identifiers.map((id, i) =>
  `${id.type}: ${id.value}${i < book.identifiers.length - 1 ? ', ' : ''}`
).join('');

const ratingStr = book.rating && book.rating.count > 0
  ? `&#9733; ${book.rating.avg} (${book.rating.count})`
  : '';

// "Tentang teks": facts line, ranked word lists and key phrases from the corpus rebuild (see cps/text_analysis.py).
const text = detail?.text ?? null;
// A book can have only the sentence tone (`text` = `{ tone }`, no corpus profile yet): 630 books in 2026-11, which made
// every one of those pages a 500 on `text.top.length`. The ranked lists therefore default to empty.
const topWords = text?.top ?? [];
const distinctWords = text?.distinct ?? [];
const phraseList = text?.phrases ?? [];
const countFormat = new Intl.NumberFormat('id-ID');
// A book can carry only the sentence tone (no corpus profile yet), so the facts line needs the word count itself.
const readingMinutes = text?.words ? Math.max(1, Math.round(text.words / 200)) : 0;
const textFacts = text?.words
  ? [
      `${countFormat.format(text.words)} kata`,
      readingMinutes >= 60
        ? `sekitar ${Math.floor(readingMinutes / 60)} jam ${readingMinutes % 60} menit baca`
        : `sekitar ${readingMinutes} menit baca`,
      `lebih panjang dari ${text.longer_than}% buku di pustaka ini`,
    ].join(' · ')
  : '';

// "Sentimen kata": a coarse lexicon score from the corpus rebuild; null when the book is not scored.
const sentiment = text?.sentiment ?? null;
const sentimentHits = sentiment ? sentiment.positive + sentiment.negative : 0;
const positiveShare = sentimentHits > 0 ? sentiment.positive / sentimentHits : 0;
// "cenderung negatif" is shown only when negative words really are the majority: the label must not contradict the
// counts printed beside it (a 52% positive share used to read "negatif" under an older, corpus-quartile cut-off).
// "cenderung positif" starts at 0.70 because Indonesian prose has a positive baseline (median ~0.61 positive share).
const toneLabel = positiveShare >= 0.70 ? 'cenderung positif' : positiveShare < 0.5 ? 'cenderung negatif' : 'berimbang';

// "Nada kalimat": the transformer classifier reads a sample of sentences (any language). Its score is calibrated
// across the library (median book at 0, middle half within +-0.25), so the cut-offs below are not the lexicon's.
const sentenceTone = text?.tone ?? null;
const sentenceToneLabel = !sentenceTone
  ? ''
  : sentenceTone.score >= 0.25 ? 'cenderung positif' : sentenceTone.score <= -0.25 ? 'cenderung negatif' : 'berimbang';
// Model emotions use two label sets (EmoT's five for Indonesian, GoEmotions' 28 for English); both get Indonesian names.
const emotionNames: Record<string, string> = {
  sadness: 'Sedih', anger: 'Marah', love: 'Cinta', fear: 'Takut', happy: 'Senang',
  admiration: 'Kagum', amusement: 'Geli', annoyance: 'Kesal', approval: 'Setuju', caring: 'Peduli',
  confusion: 'Bingung', curiosity: 'Penasaran', desire: 'Ingin', disappointment: 'Kecewa',
  disapproval: 'Tidak setuju', disgust: 'Jijik', embarrassment: 'Malu', excitement: 'Antusias',
  frustration: 'Frustrasi', gratitude: 'Syukur', grief: 'Duka', joy: 'Senang', nervousness: 'Gugup',
  optimism: 'Optimis', pride: 'Bangga', realization: 'Sadar', relief: 'Lega', remorse: 'Menyesal',
  surprise: 'Terkejut', contempt: 'Meremehkan', neutral: 'Netral',
};
const measure = Boolean(sentenceTone || sentiment);
const modelEmotions = (sentenceTone?.emotions ?? []).map(([code, share]) => `${emotionNames[code] ?? code} ${Math.round(share * 100)}%`);

// Trend: 16 sections, null where a section had too few polarity words; each run of scored sections becomes one line.
const trend = sentiment?.trend ?? [];
const trendSegments: string[] = [];
let trendSegment: string[] = [];
trend.forEach((value, index) => {
  if (value === null) {
    if (trendSegment.length > 1) trendSegments.push(trendSegment.join(' '));
    trendSegment = [];
    return;
  }
  trendSegment.push(
    `${((index / Math.max(1, trend.length - 1)) * 240).toFixed(1)},${(24 - value * 20).toFixed(1)}`,
  );
});
if (trendSegment.length > 1) trendSegments.push(trendSegment.join(' '));

// Dominant emotions (Plutchik's eight, from the same lexicon); percentages are shares of all emotion words.
const emotionLabels: Record<string, string> = {
  anger: 'Marah', fear: 'Takut', sadness: 'Sedih', joy: 'Senang',
  trust: 'Percaya', surprise: 'Terkejut', disgust: 'Jijik', anticipation: 'Harapan',
};
const emotionCounts = sentiment?.emotions ?? [];
const emotionTotal = emotionCounts.reduce((sum, [, count]) => sum + count, 0);
const topEmotions = emotionCounts.slice(0, 3);

// "Buku serupa": ids from the corpus rebuild, resolved against the live catalog (a book removed since is dropped).
const booksById = new Map(getAllBooks().map(b => [b.id, b]));
const similarBooks = (text?.similar ?? []).flatMap(([otherId]) => booksById.get(otherId) ?? []);
---

<BookLayout book={book} description={cleanComment || undefined}>
  <article class="book-detail">
    <div class="cover">
      <Cover image={book.cover_url.replace(/\?.*$/, '')} alt={book.title} width={320} height={480} loading="eager" fetchpriority="high" />
    </div>
    <div class="body">
      <h1>{book.title}</h1>

      {book.authors.length > 0 && (
        <p class="authors"><strong>Penulis:</strong> <span set:html={authorStr} /></p>
      )}

      {cleanComment && (
        <div class="description" set:html={cleanComment} />
      )}

      <div class="formats">
        {buttons.map(b => (
          <a href={b.href} download="true" set:html={`Unduh ${b.label} ${b.sizeText}`} />
        ))}
        {readUrl && (
          <a href={`/read/${book.id}/${readUrl}`}>Baca Online</a>
        )}
        {[...ocrUrls.entries()].map(([format, link]) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
        ))}
        <a id="staff-edit" class="staff-edit" href={`/admin/book/${book.id}`} rel="nofollow" hidden>Sunting buku</a>
        <script is:inline>
          // The page is cached for everyone, so the link is revealed here, and only for people who logged in as staff
          // (a readable marker set at login). The marker proves nothing: /api/whoami checks the real session.
          if (/(?:^|; )pustaka_staff=1/.test(document.cookie)) {
            fetch('/api/whoami', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (who) {
                if (who && who.edit) document.getElementById('staff-edit').hidden = false;
              })
              .catch(function () {});
          }
        </script>
      </div>

      <table class="metadata">
        <tbody>
          {book.publisher && (
            <tr>
              <th scope="row">Penerbit</th>
              <td><a href={`/publisher/${book.publisher.id}/`} set:html={book.publisher.name} /></td>
            </tr>
          )}
          {reliablePubdate(book) && (
            <tr><th scope="row">Tahun</th><td>{reliablePubdate(book)}</td></tr>
          )}
          {book.languages.length > 0 && (
            <tr>
              <th scope="row">Bahasa</th>
              <td set:html={langLinks} />
            </tr>
          )}
          {book.series && (
            <tr>
              <th scope="row">Seri</th>
              <td>
                {book.series.index != null
                  ? `${book.series.name} jilid ${book.series.index}`
                  : book.series.name
                }
              </td>
            </tr>
          )}
          {identStr && (
            <tr><th scope="row">Pengenal</th><td set:html={identStr} /></tr>
          )}
          {ratingStr && (
            <tr><th scope="row">Penilaian</th><td set:html={ratingStr} /></tr>
          )}
          {book.tags.length > 0 && (
            <tr><th scope="row">Kategori</th><td set:html={catLinks} /></tr>
          )}
        </tbody>
      </table>

      {book.tags.length > 0 && (
        <ul class="tag-list" set:html={tagStr} />
      )}

      {bookShelves.length > 0 && (
        <>
          <h2 class="shelves-heading">Rak</h2>
          <ul class="tag-list" set:html={shelfStr} />
        </>
      )}

      {text && (
        <section class="book-text">
          <h2 class="shelves-heading">Tentang teks</h2>
          {textFacts && <p class="book-text__facts">{textFacts}</p>}
          {measure && (
            <details class="book-text__measure">
              <summary>Nada &amp; emosi <span class="book-text__hint">eksperimental</span></summary>
              {sentenceTone && (
                <p class="book-text__note">
                  Nada kalimat (model): {sentenceToneLabel}
                  {sentenceTone.positive_share !== null
                    ? ` · ${Math.round(sentenceTone.positive_share * 100)}% kalimat positif atau negatif dari ${countFormat.format(sentenceTone.sentences)} kalimat contoh`
                    : ''}
                </p>
              )}
              {modelEmotions.length > 0 && (
                <p class="book-text__note">Emosi dominan (model): {modelEmotions.join(' · ')}</p>
              )}
              {sentiment && (
                <div class="book-text__sentiment">
                  <p class="book-text__note">
                    Sentimen kata: {toneLabel} · {countFormat.format(sentiment.positive)} kata positif, {countFormat.format(sentiment.negative)} negatif
                  </p>
                  {trendSegments.length > 0 && (
                    <svg class="book-text__trend" viewBox="0 0 240 48" preserveAspectRatio="none" role="img" aria-label="Tren sentimen kata dari awal ke akhir buku">
                      <line class="book-text__trend-zero" x1="0" y1="24" x2="240" y2="24" />
                      {trendSegments.map(points => <polyline class="book-text__trend-line" points={points} />)}
                    </svg>
                  )}
                  {topEmotions.length > 0 && (
                    <>
                      <h3>Emosi dominan (leksikon)</h3>
                      <ol class="book-text__rank book-text__emotions">
                        {topEmotions.map(([code, count]) => (
                          <li>
                            <span>{emotionLabels[code] ?? code}</span>
                            <span class="book-text__bar" aria-hidden="true"><i style={`width:${(count / emotionTotal) * 100}%`}></i></span>
                            <b>{Math.round((count / emotionTotal) * 100)}%</b>
                          </li>
                        ))}
                      </ol>
                    </>
                  )}
                  <p class="book-text__note">
                    {trendSegments.length > 0 && 'Grafik: tiap bagian buku, dari awal (kiri) ke akhir (kanan). '}
                    Perkiraan kasar dari kata dan kalimat, relatif terhadap pustaka ini; mengukur pilihan kata, bukan isi
                    atau mutu buku, dan tidak menangkap ironi.
                  </p>
                </div>
              )}
            </details>
          )}
          {(topWords.length > 0 || distinctWords.length > 0) && (
            <div class="book-text__lists">
              {topWords.length > 0 && (
                <div>
                  <h3>Paling sering muncul</h3>
                  <ol class="book-text__rank">
                    {topWords.map(([word, count]) => (
                      <li><span>{word}</span><span class="book-text__bar" aria-hidden="true"><i style={`width:${(count / topWords[0][1]) * 100}%`}></i></span><b>{countFormat.format(count)}</b></li>
                    ))}
                  </ol>
                </div>
              )}
              {distinctWords.length > 0 && (
                <div>
                  <h3>Khas buku ini</h3>
                  <p class="book-text__note">Sering di buku ini, jarang di buku lain.</p>
                  <ol class="book-text__rank">
                    {distinctWords.map(([word, count]) => (
                      <li><span>{word}</span><b>{countFormat.format(count)}</b></li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
          )}
          {phraseList.length > 0 && (
            <div>
              <h3>Frasa yang berulang</h3>
              <ul class="book-text__phrases">
                {phraseList.map(([phrase, count]) => (
                  <li><a href={`/search/text/?${new URLSearchParams({ q: `"${phrase.replaceAll('"', '')}"` })}`} title={`${count} kali di buku ini. Cari frasa ini di dalam teks semua buku`}>{phrase}</a></li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}
    </div>
  </article>

  {similarBooks.length > 0 && (
    <section class="similar-books">
      <h2 class="shelves-heading">Buku serupa</h2>
      <p class="similar-books__note">Dipilih dari kemiripan kata-kata khas di dalam teks.</p>
      <BookGrid books={similarBooks} level={3} />
    </section>
  )}
</BookLayout>

<style is:global>
  @import '../../../styles/book.css';
</style>
