---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getAllLanguages, booksByLanguage, localeLanguageName, PAGE_SIZE } from '~/data';

export const getStaticPaths = (({ paginate }) => {
  return getAllLanguages().flatMap(l => {
    const items = booksByLanguage(l.lang_code).sort((x, y) =>
      (y.timestamp || '').localeCompare(x.timestamp || '')
    );
    return paginate(items, {
      params: { id: l.lang_code },
      pageSize: PAGE_SIZE,
      props: { language: l },
    });
  });
}) satisfies GetStaticPaths;

const { page, language } = Astro.props;
const isFirstPage = page.currentPage === 1;
const baseUrl = `/language/${language.lang_code}/`;
const langName = localeLanguageName(language.lang_code);
---

<BaseLayout title={`Bahasa: ${langName}${isFirstPage ? '' : ` (Halaman ${page.currentPage})`}`} description={`Buku berbahasa ${langName} (${language.lang_code}) — ${page.total} buku di Pustaka Taratsa`} canonical={baseUrl} noindex={!isFirstPage}>
  {isFirstPage ? (
    <p><a href="/language">‹ Semua bahasa</a></p>
  ) : (
    <p><a href={baseUrl}>‹ {langName}</a></p>
  )}
  <h1>{langName} ({language.lang_code})</h1>
  <p>{page.total} buku dalam bahasa ini.</p>

  <BookGrid books={page.data} cols={4} />
  <Pagination page={page.currentPage} totalPages={page.lastPage} baseUrl={baseUrl} />
</BaseLayout>