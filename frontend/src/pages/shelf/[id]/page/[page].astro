---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getShelves, getAllBooks, paginate } from '~/data';
import type { BookSummary } from '~/data/types';

const { id, page } = Astro.params;
const shelf = getShelves().find(s => String(s.id) === id);
if (!shelf) return new Response(null, { status: 404 });
const pageNum = page && /^[1-9]\d*$/.test(page) ? Number(page) : NaN;

const allBooks = getAllBooks();
const bookMap = new Map<number, BookSummary>(allBooks.map(b => [b.id, b]));
const ordered: BookSummary[] = [];
for (const id of shelf.book_ids) {
  const b = bookMap.get(id);
  if (b) ordered.push(b);
}
const { items, page: p, totalPages } = paginate(ordered, pageNum);
const total = ordered.length;

if (!Number.isSafeInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 });
}
---

<BaseLayout title={`Rak: ${shelf.name} (Halaman ${p})`} description={`${shelf.name} — halaman ${p} dari ${totalPages} — ${total} buku dalam rak ini di Pustaka Taratsa`} canonical={`/shelf/${shelf.id}`} noindex ogType="website">
  <p><a href={`/shelf/${shelf.id}`}>‹ {shelf.name}</a></p>
  <h1>{shelf.name}</h1>
  <p>{total} buku dalam rak ini.</p>

  <BookGrid books={items} cols={4} />
  <Pagination page={p} totalPages={totalPages} baseUrl={`/shelf/${shelf.id}`} />
</BaseLayout>