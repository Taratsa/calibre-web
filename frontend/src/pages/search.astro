---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { searchBooks, type SearchableBook } from '~/utils/search';
import { truncateAuthorsHtml } from '~/utils/authors';

const q = (Astro.url.searchParams.get('q') || '').trim();
const { hits, total } = q ? searchBooks(q, 120) : { hits: [], total: 0 };
const terms = q ? q.toLowerCase().split(/\s+/).filter(Boolean) : [];
const statusText = total > hits.length ? `Menampilkan ${hits.length} dari ${total} hasil` : `${total} hasil`;
const initialHtml = renderResults(hits);

function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function highlight(s: string, terms: string[]): string {
  let out = escapeHtml(s);
  for (const t of terms) {
    const re = new RegExp(`(${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    out = out.replace(re, '<mark>$1</mark>');
  }
  return out;
}

function coverHtml(image: string, alt: string): string {
  const clean = image.replace(/\?.*$/, '');
  if (clean.startsWith('/cover/')) {
        return `<picture><source srcset="${clean}" type="image/webp"><img src="${clean}" alt="${escapeHtml(alt)}" loading="lazy" width="200" height="300" decoding="async"></picture>`;
  }
  return `<img src="${clean}" alt="${escapeHtml(alt)}" loading="lazy" width="200" height="300" decoding="async">`;
}

function renderResults(hits: SearchableBook[]): string {
  return hits.map(b => {
    const titleHighlighted = highlight(b.title, terms);
    const authorHtml = truncateAuthorsHtml(b.authors, 60);

    return `<li><article class="card">
      <a href="${b.url}" class="card__cover" aria-label="Cover ${escapeHtml(b.title)}">${coverHtml(b.cover_url, b.title)}</a>
      <h3 class="card__title"><a href="${b.url}">${titleHighlighted}</a></h3>
      <p class="card__authors">${authorHtml}</p>
    </article></li>`;
  }).join('');
}
---

<BaseLayout title={q ? `Cari: ${q}` : 'Cari'} description="Cari buku di Pustaka Taratsa." noindex>
  <div class="search-page">
    <h1 class="search-title">Cari Buku</h1>

    <form action="/search" method="GET" role="search" class="search-form">
      <div class="search-form__input-wrap">
        <svg class="search-form__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" name="q" placeholder="Cari judul, penulis, kategori…" value={q} autofocus spellcheck="false" />
      </div>
      <button type="submit" class="search-form__btn">Cari</button>
    </form>

    {q && total > 0 && (
      <p id="search-status" class="search-status">{statusText} untuk "<strong>{q}</strong>"</p>
    )}

    {hits.length > 0 && (
      <div id="search-results" class="search-results">
        <ul class="book-grid book-grid--cols-5" set:html={initialHtml} />
      </div>
    )}

    {q && total === 0 && (
      <div id="search-empty" class="search-empty">
        <p>Tidak ditemukan hasil untuk "<strong>{q}</strong>".</p>
        <p class="search-empty__suggest">Coba kata kunci lain, periksa ejaan, atau <a href="/">kembali ke beranda</a>.</p>
      </div>
    )}
  </div>
</BaseLayout>
<style>
  .search-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  /* ── Search Form ── */
  .search-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .search-form__input-wrap {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-form__icon {
    position: absolute;
    left: 0.75rem;
    color: var(--muted-soft);
    pointer-events: none;
    flex-shrink: 0;
  }
  .search-form__input-wrap input {
    width: 100%;
    padding: 0.65rem 0.9rem 0.65rem 2.4rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    font: inherit;
    font-size: 0.95rem;
    background: var(--surface);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .search-form__input-wrap input:focus {
    outline: none;
    border-color: var(--fg);
    box-shadow: 0 0 0 3px var(--ring);
  }
  .search-form__btn {
    padding: 0.65rem 1.3rem;
    background: var(--fg);
    color: var(--inverse-fg);
    border: 0;
    border-radius: 4px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .search-form__btn:hover { background: var(--muted-strong); }

  /* ── Status ── */
  .search-status {
    margin: 0 0 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--surface-2);
    border-radius: 4px;
    font-size: 0.88rem;
    color: var(--muted-strong);
  }

  /* ── Results Container ── */
  .search-results:not([hidden]) {
    animation: fadeIn 0.2s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-results:not([hidden]) { animation: none; }
  }


  /* ── Grid ── */
  .book-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    gap: 1.5rem;
  }
  .book-grid--cols-5 { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }

  /* ── Card ── */
  .card { margin: 0; }
  .card__cover { display: block; }
  .card__cover img,
  .card__cover picture {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 1px 4px var(--shadow-sm);
  }
  .card__title {
    font-size: 1rem;
    margin: 0.5rem 0 0.25rem;
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .card__title a {
    color: var(--fg);
    text-decoration: none;
  }
  .card__title a:hover { text-decoration: underline; }
  :global(.card__title mark) {
    background: var(--mark-bg);
    color: var(--mark-fg);
    padding: 0 0.1rem;
    border-radius: 2px;
  }
  .card__authors {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
  }
  .card__authors a { color: var(--muted); }
  .card__authors a:hover { color: var(--fg); }
  .card__authors .more { color: var(--muted-soft); font-style: italic; }

  /* ── Empty State ── */
  .search-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--muted);
  }
  .search-empty p { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .search-empty__suggest {
    font-size: 0.85rem !important;
    color: var(--muted-soft);
  }
  .search-empty a { color: var(--fg); }

</style>
