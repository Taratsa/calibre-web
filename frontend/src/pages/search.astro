---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import SearchTabs from '~/components/SearchTabs.astro';
import { getAllBooks, localeLanguageName } from '~/data';
import type { BookSummary } from '~/data/types';
import {
  SORT_KEYS,
  hasAdvancedCriteria,
  searchCatalog,
  searchFacets,
  type SearchRequest,
  type SortKey,
} from '~/utils/search';
import { FulltextUnavailable, fulltextConfigured, searchFulltext, type FulltextHit } from '~/utils/fulltext';
import { highlight, where } from '~/utils/fulltext-snippet';
import { authorPath } from '~/utils/author-url';
import { bookPath } from '~/utils/book-url';
import Cover from '~/components/Cover.astro';

// Old Calibre-Web links, bots and OpenSearch descriptions send ?query=; this page reads ?q=.
if (Astro.url.searchParams.has('query') && !Astro.url.searchParams.has('q')) {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.set('q', next.get('query') ?? '');
  next.delete('query');
  return Astro.redirect(`/search/?${next.toString()}`, 301);
}

const PAGE_SIZE = 48;
const params = Astro.url.searchParams;
const text = (name: string) => (params.get(name) ?? '').trim().slice(0, 200);
const year = (name: string) => {
  const value = Number.parseInt(params.get(name) ?? '', 10);
  return Number.isFinite(value) && value >= 1000 && value <= 2100 ? value : null;
};
const sortParam = params.get('sort') as SortKey | null;

const request: SearchRequest = {
  q: text('q'),
  title: text('title'),
  author: text('author'),
  publisher: text('publisher'),
  series: text('series'),
  tag: text('tag'),
  lang: text('lang'),
  format: text('format').toLowerCase(),
  yearFrom: year('from'),
  yearTo: year('to'),
  sort: sortParam && SORT_KEYS.includes(sortParam) ? sortParam : 'relevance',
};

const facets = searchFacets();
const searched = Boolean(request.q) || hasAdvancedCriteria(request);
const outcome = searched ? searchCatalog(request) : null;
const matches = outcome?.matches ?? [];
const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
const page = Math.min(Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1), totalPages);
const shown = matches.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

// Keep the form open when any advanced field is in use, so the person sees why a result is narrow.
const advancedFields = [request.title, request.author, request.publisher, request.series, request.tag, request.lang, request.format];
const advancedCount =
  advancedFields.filter(Boolean).length + (request.yearFrom != null || request.yearTo != null ? 1 : 0) + (request.sort !== 'relevance' ? 1 : 0);
const advancedOpen = params.get('advanced') === '1' || advancedCount > 0;

function pageHref(target: number): string {
  const next = new URLSearchParams(params);
  if (target <= 1) next.delete('page');
  else next.set('page', String(target));
  const query = next.toString();
  return `/search/${query ? `?${query}` : ''}`;
}

const sortLabels: Record<SortKey, string> = {
  relevance: 'Paling relevan',
  newest: 'Terbaru ditambahkan',
  title: 'Judul A–Z',
  year: 'Tahun terbit (terbaru)',
};
const formatLabel = (value: string) => value.toUpperCase();
const formatCount = new Intl.NumberFormat('id-ID');

// Chips echo the active criteria; each links to the same search without it.
const labels: Record<string, string> = {
  title: 'Judul', author: 'Penulis', publisher: 'Penerbit', series: 'Seri', tag: 'Kategori', lang: 'Bahasa', format: 'Format',
};
const chips: Array<{ label: string; href: string }> = [];
if (searched) {
  const without = (...names: string[]) => {
    const next = new URLSearchParams(params);
    next.delete('page');
    for (const name of names) next.delete(name);
    const query = next.toString();
    return `/search/${query ? `?${query}` : ''}`;
  };
  for (const key of ['title', 'author', 'publisher', 'series', 'tag'] as const) {
    if (request[key]) chips.push({ label: `${labels[key]}: ${request[key]}`, href: without(key) });
  }
  if (request.lang) chips.push({ label: `Bahasa: ${localeLanguageName(request.lang === 'ind' ? 'id' : request.lang === 'eng' ? 'en' : request.lang)}`, href: without('lang') });
  if (request.format) chips.push({ label: `Format: ${formatLabel(request.format)}`, href: without('format') });
  if (request.yearFrom != null || request.yearTo != null) {
    chips.push({ label: `Tahun: ${request.yearFrom ?? '…'}–${request.yearTo ?? '…'}`, href: without('from', 'to') });
  }
  if (request.sort !== 'relevance') chips.push({ label: `Urut: ${sortLabels[request.sort!]}`, href: without('sort') });
}

const title = request.q ? `Cari: ${request.q}` : searched ? 'Pencarian lanjutan' : 'Cari';
const languageName = (code: string) => localeLanguageName(code === 'ind' ? 'id' : code === 'eng' ? 'en' : code === 'msa' ? 'ms' : code);

// When the catalog (titles, authors, categories) has few answers for a plain query, show the best passages from inside
// the books too, so a search for a name or a phrase that lives in the text is not a dead end. Manticore being down or
// slow only hides this block; the catalog result never depends on it.
const TEXT_FALLBACK_BELOW = 5;
const TEXT_FALLBACK_HITS = 3;
const plainQuery = Boolean(request.q) && !hasAdvancedCriteria(request);
let textHits: Array<{ hit: FulltextHit; book: BookSummary }> = [];
let textTotal = 0;
if (plainQuery && page === 1 && matches.length < TEXT_FALLBACK_BELOW && fulltextConfigured()) {
  try {
    const found = await searchFulltext(request.q!, 1);
    if (found) {
      textTotal = found.total;
      const booksById = new Map(getAllBooks().map((book) => [book.id, book]));
      textHits = found.hits.flatMap((hit) => {
        const book = booksById.get(hit.bookId);
        return book ? [{ hit, book }] : [];
      }).slice(0, TEXT_FALLBACK_HITS);
    }
  } catch (error) {
    if (!(error instanceof FulltextUnavailable)) throw error;
    console.error(`[fulltext] ${error.message}`);
  }
}
---

<BaseLayout title={title} description="Cari buku di Pustaka Taratsa." noindex>
  <div class="search-page">
    <h1 class="search-title">Cari</h1>
    <SearchTabs active="catalog" q={request.q} />

    <form action="/search/" method="GET" role="search" class="search-form">
      <div class="search-form__row">
        <div class="search-form__input-wrap">
          <svg class="search-form__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" name="q" placeholder="Cari judul, penulis, kategori…" value={request.q} autofocus={!searched} autocomplete="off" spellcheck="false" aria-label="Kata kunci" />
        </div>
        <button type="submit" class="search-form__btn">Cari</button>
      </div>
      <details class="advanced" open={advancedOpen}>
        <summary>
          Pencarian lanjutan
          {advancedCount > 0 && <span class="advanced__count" aria-label={`${advancedCount} kriteria aktif`}>{advancedCount}</span>}
        </summary>
        <div class="advanced__body">
          <fieldset class="advanced__group">
            <legend>Judul dan pengarang</legend>
            <label>Judul<input type="text" name="title" value={request.title} autocomplete="off" spellcheck="false" /></label>
            <label>Penulis<input type="text" name="author" value={request.author} autocomplete="off" spellcheck="false" /></label>
            <label>Penerbit<input type="text" name="publisher" value={request.publisher} autocomplete="off" spellcheck="false" /></label>
            <label>Seri<input type="text" name="series" value={request.series} autocomplete="off" spellcheck="false" /></label>
            <label>Kategori<input type="text" name="tag" value={request.tag} autocomplete="off" spellcheck="false" /></label>
          </fieldset>
          <fieldset class="advanced__group">
            <legend>Jenis buku</legend>
            <label>Bahasa
              <select name="lang">
                <option value="">Semua bahasa</option>
                {facets.languages.map((facet) => (
                  <option value={facet.value} selected={request.lang === facet.value}>{languageName(facet.value)} ({formatCount.format(facet.count)})</option>
                ))}
              </select>
            </label>
            <label>Format
              <select name="format">
                <option value="">Semua format</option>
                {facets.formats.map((facet) => (
                  <option value={facet.value} selected={request.format === facet.value}>{formatLabel(facet.value)} ({formatCount.format(facet.count)})</option>
                ))}
              </select>
            </label>
            <div class="advanced__years">
              <label>Tahun terbit, dari<input type="number" name="from" min="1000" max="2100" inputmode="numeric" placeholder={String(facets.yearMin ?? '')} value={request.yearFrom ?? ''} /></label>
              <label>sampai<input type="number" name="to" min="1000" max="2100" inputmode="numeric" placeholder={String(facets.yearMax ?? '')} value={request.yearTo ?? ''} /></label>
            </div>
          </fieldset>
          <fieldset class="advanced__group advanced__group--sort">
            <legend>Urutan</legend>
            <label>Urutkan
              <select name="sort">
                {SORT_KEYS.map((key) => (
                  <option value={key} selected={request.sort === key}>{sortLabels[key]}</option>
                ))}
              </select>
            </label>
          </fieldset>
        </div>
        <p class="advanced__help">
          Kotak utama: <code>"frasa tepat"</code> mencari kata berurutan, <code>-kata</code> membuang buku yang memuat kata itu.
          Filter tahun hanya menyertakan buku yang tahun terbitnya diketahui.
        </p>
        <div class="advanced__actions">
          <button type="submit" class="advanced__apply">Terapkan</button>
          <a href={request.q ? `/search/?q=${encodeURIComponent(request.q)}` : '/search/'}>Atur ulang</a>
        </div>
      </details>
    </form>

    {chips.length > 0 && (
      <ul class="chips" aria-label="Kriteria aktif">
        {chips.map((chip) => (
          <li><a href={chip.href} title="Hapus kriteria ini">{chip.label} <span aria-hidden="true">×</span></a></li>
        ))}
      </ul>
    )}

    {searched && matches.length > 0 && (
      <p id="search-status" class="search-status">
        {formatCount.format(matches.length)} hasil{request.q ? <> untuk "<strong>{request.q}</strong>"</> : null}
        {totalPages > 1 && <> · halaman {page} dari {totalPages}</>}
        {outcome?.yearFilterApplied && <> · buku tanpa tahun terbit yang pasti tidak disertakan</>}
      </p>
    )}

    {shown.length > 0 && (
      <div id="search-results" class="search-results">
        <BookGrid books={shown} />
      </div>
    )}

    {totalPages > 1 && (
      <nav class="search-pager" aria-label="Halaman hasil">
        {page > 1 ? <a href={pageHref(page - 1)} rel="prev">← Sebelumnya</a> : <span aria-disabled="true">← Sebelumnya</span>}
        <span class="search-pager__where">Halaman {page} / {totalPages}</span>
        {page < totalPages ? <a href={pageHref(page + 1)} rel="next">Selanjutnya →</a> : <span aria-disabled="true">Selanjutnya →</span>}
      </nav>
    )}

    {textHits.length > 0 && (
      <section class="search-passages" aria-labelledby="search-passages-title">
        <h2 id="search-passages-title">Juga ditemukan di dalam teks buku</h2>
        <ol class="search-passages__list">
          {textHits.map(({ hit, book }) => (
            <li class="search-passage">
              <a class="search-passage__cover" href={`${bookPath(book)}/`} tabindex="-1" aria-hidden="true">
                <Cover image={book.cover_url.replace(/\?.*$/, '')} alt="" width={72} height={108} loading="lazy" />
              </a>
              <div>
                <h3 class="search-passage__title"><a href={`${bookPath(book)}/`} set:html={book.title.trim()} /></h3>
                {book.authors.length > 0 && (
                  <p class="search-passage__authors">
                    {book.authors.map((author, index) => (
                      <>{index > 0 && ', '}<a href={`${authorPath(author)}/`}>{author.name}</a></>
                    ))}
                  </p>
                )}
                <p class="search-passage__snippet" set:html={highlight(hit.snippet)} />
                <p class="search-passage__meta">
                  <span>{where(hit.progress)}</span>
                  <span aria-hidden="true">·</span>
                  <a href={`/read/${book.id}/ocr/${hit.format}/`}>Baca teks ({hit.format.toUpperCase()})</a>
                </p>
              </div>
            </li>
          ))}
        </ol>
        {textTotal > textHits.length && (
          <p class="search-passages__more">
            <a href={`/search/text/?q=${encodeURIComponent(request.q)}`}>Lihat {formatCount.format(textTotal)} buku yang memuat "{request.q}"</a>
          </p>
        )}
      </section>
    )}

    {searched && request.q && (
      <p class="search-crosslink">
        Mencari kata di dalam isi buku? <a href={`/search/text/?q=${encodeURIComponent(request.q)}`}>Cari "{request.q}" di dalam teks</a>
      </p>
    )}

    {searched && matches.length === 0 && (
      <div id="search-empty" class="search-empty">
        <p>Tidak ada buku yang cocok dengan judul, penulis, atau kategorinya.</p>
        <p class="search-empty__suggest">
          {chips.length > 0 ? 'Longgarkan salah satu kriteria di atas, periksa ejaan, ' : 'Coba kata kunci lain, periksa ejaan, '}
          atau <a href="/">kembali ke beranda</a>.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .search-passages { margin: 1.75rem 0 0; padding-top: 1rem; border-top: 1px solid var(--border-subtle); }
  .search-passages h2 { margin: 0 0 0.9rem; font-size: 1rem; font-weight: 600; }
  .search-passages__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .search-passage { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 0.85rem; align-items: start; }
  .search-passage__cover :global(img) { width: 100% !important; height: auto; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 4px; background: var(--surface-3); box-shadow: 0 1px 3px var(--shadow-sm); }
  .search-passage__title { margin: 0; font-size: 0.95rem; line-height: 1.3; font-weight: 600; }
  .search-passage__title a { color: var(--fg); text-decoration: none; }
  .search-passage__title a:hover { text-decoration: underline; }
  .search-passage__authors { margin: 0.1rem 0 0; font-size: 0.8rem; color: var(--muted); }
  .search-passage__authors a { color: var(--muted); text-decoration: none; }
  .search-passage__snippet { margin: 0.35rem 0 0; font-size: 0.86rem; line-height: 1.55; overflow-wrap: anywhere; }
  .search-passage__snippet :global(mark) { background: var(--mark-bg); color: var(--mark-fg); border-radius: 2px; padding: 0 0.1em; font-weight: 600; }
  .search-passage__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem 0.5rem; margin: 0.35rem 0 0; font-size: 0.78rem; color: var(--muted); }
  .search-passage__meta a { display: inline-flex; align-items: center; min-height: 32px; color: var(--fg); }
  .search-passages__more { margin: 0.9rem 0 0; font-size: 0.9rem; }
  .search-passages__more a { display: inline-flex; align-items: center; min-height: 40px; color: var(--fg); }
  .search-title { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.75rem; }
  .search-crosslink { margin: 1.5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--muted-strong); }
  .search-crosslink a { display: inline-flex; align-items: center; min-height: 40px; color: var(--fg); }

  .search-form { margin-bottom: 1.25rem; }
  .search-form__row { display: flex; gap: 0.5rem; }
  .search-form__input-wrap { flex: 1; position: relative; display: flex; align-items: center; }
  .search-form__icon { position: absolute; left: 0.75rem; color: var(--muted-soft); pointer-events: none; }
  .search-form__input-wrap input {
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 0.9rem 0.65rem 2.4rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    font: inherit;
    font-size: 0.95rem;
    background: var(--surface);
    color: var(--fg);
  }
  .search-form__input-wrap input:focus,
  .advanced input:focus,
  .advanced select:focus { outline: 2px solid var(--focus); outline-offset: 1px; }
  .search-form__btn {
    min-height: 44px;
    padding: 0.65rem 1.3rem;
    background: var(--fg);
    color: var(--inverse-fg);
    border: 0;
    border-radius: 4px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }
  .search-form__btn:hover { background: var(--muted-strong); }

  .advanced { margin-top: 0.75rem; }
  .advanced > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted-strong);
  }
  .advanced > summary:hover { color: var(--fg); }
  .advanced > summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  .advanced[open] > summary { color: var(--fg); }
  .advanced__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.35rem;
    border-radius: 4px;
    background: var(--fg);
    color: var(--inverse-fg);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .advanced__body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .advanced__group {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-width: 0;
    margin: 0;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    background: var(--surface-2);
  }
  .advanced__group legend { padding: 0 0.4rem; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .advanced label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.8rem; color: var(--muted-strong); }
  .advanced input,
  .advanced select {
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 0.95rem;
  }
  .advanced__years { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .advanced__help { margin: 0.75rem 0 0; font-size: 0.8rem; color: var(--muted); }
  .advanced__help code { padding: 0 0.25rem; border-radius: 2px; background: var(--surface-3); font-size: 0.95em; }
  .advanced__actions { display: flex; align-items: center; gap: 1rem; margin: 0.75rem 0 0; font-size: 0.9rem; }
  .advanced__apply {
    min-height: 44px;
    padding: 0 1.3rem;
    background: var(--fg);
    color: var(--inverse-fg);
    border: 0;
    border-radius: 4px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
  }
  .advanced__apply:hover { background: var(--muted-strong); }
  .advanced__apply:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .advanced__actions a { display: inline-flex; align-items: center; min-height: 44px; color: var(--fg); }

  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1rem; padding: 0; list-style: none; }
  .chips a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 32px;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.8rem;
    color: var(--fg);
    text-decoration: none;
  }
  .chips a:hover { background: var(--surface-3); }

  .search-status {
    margin: 0 0 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--surface-2);
    border-radius: 4px;
    font-size: 0.88rem;
    color: var(--muted-strong);
  }

  .search-pager { display: flex; align-items: center; justify-content: center; gap: 1.25rem; margin: 2rem 0 0.5rem; font-size: 0.9rem; }
  .search-pager a, .search-pager span[aria-disabled] {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.9rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
  }
  .search-pager span[aria-disabled] { color: var(--muted-soft); border-color: var(--border-subtle); }
  .search-pager a:hover { background: var(--surface-3); }
  .search-pager__where { color: var(--muted); }

  .search-empty { text-align: center; padding: 3rem 1rem; color: var(--muted); }
  .search-empty p { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .search-empty__suggest { font-size: 0.85rem !important; color: var(--muted-soft); }
  .search-empty a { color: var(--fg); }

  @media (max-width: 479px) {
    .search-form__row { flex-direction: column; }
    .search-form__btn { min-height: 44px; }
  }
</style>
