---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookGrid from '~/components/BookGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getAllSeries, booksBySeries, paginate } from '~/data';

const { id, page } = Astro.params;
const series = getAllSeries().find(s => String(s.id) === id);
if (!series) return new Response(null, { status: 404 });
const pageNum = page && /^[1-9]\d*$/.test(page) ? Number(page) : NaN;

const all = booksBySeries(series.id).sort((a, b) => {
  const ai = a.series?.index ?? Infinity;
  const bi = b.series?.index ?? Infinity;
  if (ai !== bi) return ai - bi;
  return (b.timestamp || '').localeCompare(a.timestamp || '');
});

const { items, page: p, totalPages, total } = paginate(all, pageNum);

if (!Number.isSafeInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 });
}
---

<BaseLayout title={`Seri: ${series.name} (Halaman ${p})`} description={`${series.name} — halaman ${p} dari ${totalPages} — ${total} buku dalam seri ini di Pustaka Taratsa`} canonical={`/series/${series.id}`} noindex ogType="website">
  <p><a href={`/series/${series.id}`}>‹ {series.name}</a></p>
  <h1>{series.name}</h1>
  <p>{total} buku dalam seri ini.</p>

  <BookGrid books={items} cols={4} />
  <Pagination page={p} totalPages={totalPages} baseUrl={`/series/${series.id}`} />
</BaseLayout>