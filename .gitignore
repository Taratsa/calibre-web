### Python ###
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
.python-version
env/
venv/
eggs/
dist/
executable/
build/
!cps/static/js/build/
vendor/
.eggs/
*.egg-info/
.installed.cfg
*.egg

### Astro frontend ###
frontend/node_modules/
frontend/dist/
# Small data JSON snapshots ARE committed (book-slugs.json is copied into the Flask image,
# legacy-book-slugs.json accumulates old slugs). The per-book files are reseed output
# (~22k files, rewritten on every reseed) and are NOT tracked: run ./build-frontend.sh to make them.
.pylint.d

# calibre-web
library/
data/
!frontend/src/data/
!frontend/src/data/book-slugs.json
# parity vectors read with include_str! by the Rust tests (a few KB of JSON)
!rust/backend/tests/data/
frontend/src/data/books/
*.db
*.log
cps/cache

# Env files (may contain secrets)
.env
.env.local
.env.*.local

.idea/
*.bak
*.log.*
.key

settings.yaml
gdrive_credentials
client_secrets.json
gmail.json
/.key

# macOS
.DS_Store

# Tool caches
.grimp_cache/
.import_linter_cache/
.ruff_cache/

# Agent / IDE artifacts
.opencode/
graphify-out/
tmp/
frontend/.astro/
frontend/public/*.txt

# Rust build output
rust/taratsa_text/target/
rust/backend/target/
rust/rebuildd/target/

# Sentence-tone model, downloaded and checksum-pinned by the Dockerfile
cps/sentiment_model/
