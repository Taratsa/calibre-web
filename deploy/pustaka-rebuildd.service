[Unit]
Description=Pustaka rebuildd: reseed and rebuild the Astro frontend when the Calibre catalog changes
Documentation=file:///home/devuser/workspaces/calibre-web/AGENTS.md
# The build runs `docker compose build/up`, so the daemon must start after Docker and needs the docker group.
After=docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/home/devuser/workspaces/calibre-web
# Optional: PUSTAKA_REPO, REBUILD_BIND, REBUILD_TOKEN, REBUILD_DEBOUNCE_SECS, REBUILD_MIN_INTERVAL_SECS,
# REBUILD_MAX_WAIT_SECS, REBUILD_POLL_SECS, REBUILD_ALLOW_DIRTY, REBUILD_TIMEOUT_SECS, RUST_LOG.
EnvironmentFile=-%h/.config/pustaka/rebuildd.env
ExecStart=/home/devuser/workspaces/calibre-web/rust/rebuildd/target/release/pustaka-rebuildd
Restart=on-failure
RestartSec=10
# A rebuild is `seed (28 s) + docker build (40 s) + recreate`; do not abort it halfway because the last session ended.
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=default.target
