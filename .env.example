# Pustaka Environment Configuration
# Copy this file to .env and configure

# ─── Hardcover API (optional) ───────────────────────────────────────────────
# Get your token from: https://hardcover.app/account/apps
# Used for Goodreads sync and reading stats
HARDCOVER_TOKEN=

# ─── Frontend Rebuild Token (optional) ──────────────────────────────────────
# Set this in Calibre-Web admin UI: Admin > Configuration > Basic Configuration
# Then paste the token here for the rebuild watcher to notify after rebuilds
WEBHOOK_TOKEN=

# ─── Flask Configuration ─────────────────────────────────────────────────────
FLASK_HOST=calibre-web-automated
FLASK_PORT=8083
FLASK_PROTOCOL=http

# ─── Rebuild Watcher ─────────────────────────────────────────────────────────
# How long to wait after detecting a DB change before rebuilding
DEBOUNCE_SECONDS=10

# How often to check for DB changes (in seconds)
POLL_INTERVAL_SECONDS=5

# ─── Onion-Location (optional) ───────────────────────────────────────────────
# Tor Browser looks for this header to advertise your .onion mirror.
# Leave empty to disable. Example:
#   ONION_LOCATION=http://rqgz7zv6h53qrrij5bvopevhfp5xngnnxkqgxb6z2fcytjde2ipnihyd.onion/
ONION_LOCATION=

# ─── PDF OCR (optional runtime configuration) ───────────────────────────────
# pdf-inspector stores models below this XDG cache root.
XDG_CACHE_HOME=/config/ocr-cache
OCR_CACHE_DIR=/config/ocr-cache/results
PDF_INSPECTOR_OFFLINE=0

# Native libraries installed by the OCR-enabled Docker image.
PDFIUM_LIB_PATH=/usr/local/lib/libpdfium.so
ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so
